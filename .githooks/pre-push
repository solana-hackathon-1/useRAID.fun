#!/bin/sh
# Opt-in: enable with `bash scripts/verify.sh install`. Blocks a push whose tree lacks a passing
# receipt from `bash scripts/verify.sh full` (docs-only changes accept the fast tier).
if [ "${RAID_SKIP_PREPUSH:-}" = 1 ]; then
  echo "pre-push verification bypassed (RAID_SKIP_PREPUSH=1)" >&2
  exit 0
fi
zero=0000000000000000000000000000000000000000
receipts=$(git rev-parse --git-path raid-verify)
status=0
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue
  tree=$(git rev-parse "$local_sha^{tree}") || { status=1; continue; }
  receipt="$receipts/$tree.json"
  if [ -f "$receipt" ] && grep -Eq '"result": ?"pass"' "$receipt" && grep -Eq '"tier": ?"full"' "$receipt"; then continue; fi
  if [ -f "$receipt" ] && grep -Eq '"result": ?"pass"' "$receipt"; then
    base=$(git merge-base "$local_sha" origin/main 2> /dev/null || git merge-base "$local_sha" main 2> /dev/null || echo "$local_sha")
    if ! git diff --name-only "$base" "$local_sha" | grep -qv -e '^docs/' -e '\.md$'; then continue; fi
  fi
  echo "Push blocked: no passing full verification receipt for tree $tree." >&2
  echo "Run: bash scripts/verify.sh full   (bypass once: RAID_SKIP_PREPUSH=1 git push)" >&2
  status=1
done
exit "$status"
