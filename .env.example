# Demo is explicit, read-only and never collects provider data.
DEMO_MODE=true
DATABASE_URL=postgresql://useraid:useraid@localhost:5432/useraid
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL remains a fallback for older deployments.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ADMIN_USER_ID=
X_BEARER_TOKEN=
X_OFFICIAL_HANDLE=useRAID
# Immutable X user IDs, not handles. X_ADMIN_USER_ID and ADMIN_X_IDS together are the only source of
# administrators: they are checked on every request, so removing an id revokes access immediately
# (the stored role is demoted at that account's next sign-in). Set one before deploying.
ADMIN_X_IDS=
# Development only. Comma-separated hostnames allowed to load dev assets (for `npm run dev:lan`).
ALLOWED_DEV_ORIGINS=
# Automatic merge of an activity-free duplicate account when someone signs in with X and a wallet
# that belong to two different accounts. Keep false: the merge path is not concurrency-safe yet.
# When false, such a sign-in is refused and both accounts stay unchanged.
ACCOUNT_FOLDS_ENABLED=false
# Both deployment gate and admin collection switch must be enabled.
LIVE_COLLECTION_APPROVED=false
X_RETENTION_DAYS=30
# Only trust this IP header when your reverse proxy overwrites it with a single value
# (the last comma-separated entry is used). Without it, public limits share one bucket.
TRUSTED_IP_HEADER=
# Staleness tier for refreshing stored posts, in minutes (minimum 5). Posts older than a day refresh at 4x.
# Final passes always read every post.
X_REFRESH_MINUTES=30
# Maximum characters of the raid-specific from:<author> search filter. X recent search allows 512
# on Basic/Pro; raise only if your account tier allows longer queries.
X_SEARCH_QUERY_MAX_CHARS=512

# ---- Wallet links ---------------------------------------------------------------------------
# Server switch for adding extra sign-in wallets (needs a connected X account). Off unless exactly
# "true". Keep false until every instance resolves linked wallets, a revoke path exists and the
# owner enables it; rolling it back never removes existing links or claims.
WALLET_LINKS_ENABLED=false
# ---- Tracking and funding -------------------------------------------------------------------
# Standalone Raids use tracking v2 by default (an unset variable means on). Set false only to pause it.
X_TRACKING_V2_ENABLED=true
# Non-token SOL funding. Configure only after provider impression_count is verified.
# The rate is lamports per 1,000 qualified post impressions, e.g. 10000000 = 0.01 SOL.
# Set an operator-approved rate; example above is not a pricing recommendation.
RAID_LAMPORTS_PER_1000_IMPRESSIONS=
# Mainnet RPC for deposit verification, USDC operations and reconciliation (HTTPS).
SOLANA_RPC_URL=
# Platform-controlled, signer-capable Solana mainnet wallet holding creator deposits and paying allocations.
RAID_FUNDING_ADDRESS=
# Creator Studio v1: shared, network-isolated USDC balance; six-decimal units.
# Wallet SIWS uses this network too; production requires explicit devnet or mainnet.
USDC_NETWORK=mainnet
USDC_FUNDING_ADDRESS=
# Operator-approved price only. Leave empty to disable funding while preserving drafts.
USDC_MICROS_PER_1000_IMPRESSIONS=
# Test mode also requires NODE_ENV=development, localhost and useraid_studio_test DB.
STUDIO_SANDBOX=false

# ---- Settlement -----------------------------------------------------------------------------
# REQUIRED for Creator Studio: while false, Studio launches and deposits are unavailable and
# settlement pauses with funds staying reserved. Enable only after deployment audit, provider
# validation, and review/settlement tests. Turning it off stops new v2 payouts; signed transactions
# still reconcile. Studio does not need LAUNCH_ENABLED or PAYOUT_ENABLED.
X_TRACKING_V2_SETTLEMENT_ENABLED=false
# Basis points of a funded pool one raider can earn (default 2500 = 25%), frozen per Raid at funding.
RAID_AUTHOR_CAP_BPS=2500
# SOL rewards below this many lamports are refunded to the creator (default: rent-exempt minimum).
SOL_MIN_PAYOUT_LAMPORTS=890880
# USDC micro-units. Rewards below the reward minimum are credited to the raider balance.
USDC_MIN_REWARD_UNITS=100000
USDC_MIN_DEPOSIT_UNITS=1000000
USDC_MIN_WITHDRAWAL_UNITS=1000000
USDC_MAX_OPEN_DEPOSITS=3
USDC_MAX_OPEN_WITHDRAWALS=3
# Target-post lookups per creator per day when saving Studio drafts.
STUDIO_LOOKUPS_PER_DAY=300

# ---- Tests ----------------------------------------------------------------------------------
# Database tests refuse any database not named useraid_test and any non-local host. Set true only
# to run them against a disposable remote useraid_test database.
ALLOW_REMOTE_TEST_DB=false

# ---- Deferred launchpad (INERT) -------------------------------------------------------------
# Launchpads are gated off in code (launchpadsAvailable is false), so these variables currently do
# nothing for new launches. Only reconciliation of already-broadcast launch transactions reads
# OPERATOR_* (and SOLANA_RPC_URL above) while open work exists. Keep the switches false.
LAUNCH_ENABLED=false
PAYOUT_ENABLED=false
PINATA_JWT=
LAUNCH_KEY_VERSION=1
# 32 random bytes, base64. Encrypts mint secrets; the worker also needs it for rows not yet rotated.
LAUNCH_KEY_1=
# Fee-wallet secrets are sealed to FEE_SEAL_PUBLIC_<version> (raw X25519 key, base64; web and worker).
FEE_SEAL_VERSION=1
FEE_SEAL_PUBLIC_1=
# pkcs8 DER X25519 private key, base64. Worker only.
FEE_SEAL_PRIVATE_1=
# 32 random bytes, base64. Signs image-upload proofs (web only).
LAUNCH_ASSET_KEY=
# Public address available to web and worker. Private key belongs only in worker environment.
OPERATOR_PUBLIC_KEY=
# Base58 Solana keypair; worker-only signer used to advance transaction fees.
OPERATOR_SECRET_KEY=
PLATFORM_TREASURY_ADDRESS=

# ---- Private unpaid Raider orientation (T008, new writes default off) ------------------------
# Configure only for a declared isolated test/pilot. Reads of owned records remain available.
# Catalog is JSON [{"id":"stable-opaque-id","label":"Work interest label"}], not assessed skills.
# Do not enable live personal-data collection before privacy/retention/recovery readiness.
RAIDER_ONBOARDING_ENABLED=false
RAIDER_ONBOARDING_CATALOG=

# Private Guild draft commands; own reads/original replay remain authenticated when disabled.
GUILD_DRAFTS_ENABLED=false
# Local synthetic HTTP verification only; not a public forwarding or production endpoint.
GUILD_DRAFT_HTTP_PREVIEW_URL=http://127.0.0.1:3015

# Private existing-project preparation only; reads/replay remain while new writes are off.
GUILD_PROJECT_PROPOSALS_ENABLED=false
# Synthetic project-proposal browser fixture only; owned loopback Next development server.
PROJECT_PROPOSAL_BROWSER_URL=http://localhost:3018
# Local synthetic API preview helper (test-only, no production connection).
PROJECT_PROPOSAL_HTTP_PREVIEW_URL=http://127.0.0.1:3015

# Private self-reported skill writes only; owned reads/original replay remain authenticated.
# Actual canonical HUMAN and admin-published catalog are required; no assessed rank is created.
SKILL_CLAIMS_ENABLED=false
# New admin catalog publication only; current authorized original replay remains available.
SKILL_TAXONOMY_PUBLICATION_ENABLED=false
# New approved practice-definition publication only; original authorized replay/read remain.
PRACTICE_TRIAL_PUBLICATION_ENABLED=false
# New unpaid practice starts only; current own original replay/read remain available.
PRACTICE_TRIAL_ATTEMPTS_ENABLED=false
# New private first submissions only; current own original replay/read remain.
PRACTICE_TRIAL_SUBMISSIONS_ENABLED=false
# Actual published catalog ID selected by the host; unset keeps private skill UI unavailable.
SKILL_TAXONOMY_ID=

# Private own-skill assessment reads only; exact `true` required, default off. Needs the catalog ID below.
SKILL_ASSESSMENT_READS_ENABLED=false
# Actual published practice-assessment catalog ID chosen by the host; unset/invalid keeps assessment hosts closed.
PRACTICE_ASSESSMENT_CATALOG_ID=
# New authorized practice-assessment decisions only; exact `true` required, default off.
PRACTICE_ASSESSMENT_DECISIONS_ENABLED=false
# New practice-trial assessments only; exact `true` required, default off.
PRACTICE_TRIAL_ASSESSMENTS_ENABLED=false
# Practice-trial ownership writes only; exact `true` required, default off.
PRACTICE_TRIAL_OWNERSHIP_ENABLED=false
# Own practice portal reads only; exact `true` plus a valid trial catalog ID required, default off.
PRACTICE_PORTAL_READS_ENABLED=false
# Actual published practice-trial catalog ID chosen by the host; unset/invalid closes portal reads.
PRACTICE_TRIAL_CATALOG_ID=
# New review-assignment issuance only; exact `true` required, default off.
PRACTICE_REVIEW_ASSIGNMENTS_ENABLED=false
# New review-policy publication only; exact `true` required, default off.
PRACTICE_REVIEW_POLICY_PUBLICATION_ENABLED=false
# Scoped review reads only; exact `true` required, default off.
PRACTICE_REVIEW_READS_ENABLED=false
# Own My Raid, review-queue and applicant reads only; exact `true` required, default off. Every work write below also needs this.
WORK_WORKSPACE_READS_ENABLED=false
# Public Raid feed page and API (live, funded, public work). Read only; exact `true` required, default off.
WORK_FEED_READS_ENABLED=false
# Operator-only work-loop metrics API (administrator sign-in also required); exact `true` required, default off.
WORK_METRICS_READS_ENABLED=false
# New work submissions only; exact `true` required, default off. Original replay/reads remain.
WORK_SUBMISSIONS_ENABLED=false
# New reviewer decisions only; exact `true` required, default off.
WORK_REVIEWS_ENABLED=false
# New application withdrawals only; exact `true` required, default off.
WORK_APPLICATIONS_ENABLED=false
# New offer issue/revoke and the founder applicant queue only; exact `true` required, default off.
WORK_ADMISSION_MANAGEMENT_ENABLED=false
# Synthetic-only, comma-separated account IDs allowed to manage listings. NOT Guild or production authority; empty denies everyone.
RAID_WORK_OPERATOR_ACCOUNT_IDS=
# Optional per-participant open-application cap (1-100); default 5.
WORK_APPLICATION_LIMIT=

# T018 Founder creation wizard (synthetic only; every flag exact "true" to enable, default off).
# Reads/page, draft saves, publication with a simulated reward reservation, and optional advice.
WORK_CREATION_READS_ENABLED=false
WORK_CREATION_SAVE_ENABLED=false
WORK_CREATION_PUBLISH_ENABLED=false
WORK_RECOMMENDATIONS_ENABLED=false
# Synthetic Guild id used for drafts (listing authority is RAID_WORK_OPERATOR_ACCOUNT_IDS above, not Guild authority).
RAID_WORK_GUILD_ID=
# JSON array of {label, policy, funded}: assets the wizard may offer and whether the simulated reserve covers each.
# Unset or malformed means no reward asset can be chosen or reserved.
WORK_REWARD_ASSETS_JSON=
# Optional reviewed rubric JSON for recommendations. Unset means no estimate; an example rubric is not pricing.
WORK_RECOMMENDATION_RUBRIC_JSON=

# T042 in-app work notifications (default off; exact "true" enables). Reads/mark-read/preferences, and the worker's dispatch pass.
# Messages are fixed text with an in-product path: no work content, no external provider, no bearer links.
NOTIFICATIONS_READS_ENABLED=false
NOTIFICATIONS_DISPATCH_ENABLED=false

