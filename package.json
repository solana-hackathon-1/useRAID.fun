{
  "name": "useraid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test:browser": "playwright test",
    "test:browser:live": "playwright test --config=playwright.live.config.ts",
    "test:browser:studio": "playwright test --config=playwright.studio.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:live": "tsx tests/live-flow.ts",
    "tracking:audit": "tsx scripts/tracking-audit.ts",
    "tracking:preview": "tsx scripts/tracking-preview.ts",
    "studio:preview": "tsx scripts/studio-preview.ts",
    "meteora:dev": "tsx scripts/meteora-devnet.ts web",
    "meteora:worker": "tsx scripts/meteora-devnet.ts worker",
    "meteora:migrate": "tsx scripts/meteora-devnet.ts migrate",
    "test:meteora:db": "tsx scripts/meteora-devnet.ts test",
    "meteora:doctor": "tsx scripts/meteora-devnet.ts doctor"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@meteora-ag/dynamic-fee-sharing-sdk": "1.1.0",
    "@prisma/client": "^6.19.0",
    "@pump-fun/pump-sdk": "^2.0.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-standard-features": "^1.5.0",
    "@solana/web3.js": "^1.99.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "bn.js": "5.2.5",
    "bs58": "^6.0.0",
    "dotenv": "^17.2.0",
    "lucide-react": "^0.468.0",
    "multiformats": "14.0.5",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bn.js": "5.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
