{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "host.ts",
    "contracts/**/*.ts",
    "skills/**/*.ts",
    "components/**/*.tsx",
    "http-contracts/**/*.ts"
  ]
}
