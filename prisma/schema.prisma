generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  xId String? @unique
  handle String
  role String @default("CREATOR")
  approved Boolean @default(false)
  suspended Boolean @default(false)
  affiliation String @default("")
  createdAt DateTime @default(now())
  xAccount XAccount?
  sessions Session[]
  raids Raid[]
  wallet WalletIdentity?
  launches TokenLaunch[]
  enrollments RewardEnrollment[]
}
model WalletIdentity {
  address String @id
  userId String @unique
  verifiedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model WalletChallenge {
  digest String @id
  address String
  message String
  expiresAt DateTime
  consumedAt DateTime?
  @@index([address, expiresAt])
}
model TokenLaunch {
  id String @id @default(cuid())
  userId String
  mint String @unique
  name String
  symbol String
  description String
  metadataUri String
  imageUri String
  bannerUri String?
  feeAddress String @unique
  feeSecret String
  mintSecret String
  preparedTx String?
  signedTx String?
  preparedHash String?
  blockhash String?
  lastValidBlockHeight Int?
  signature String? @unique
  status String @default("PREPARED")
  reservationExpiresAt DateTime?
  error String?
  raidId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  raid Raid? @relation("CurrentLaunchRaid", fields: [raidId], references: [id])
  raids Raid[] @relation("LaunchRaids")
  claims FeeClaim[]
  rounds RewardRound[]
  enrollments RewardEnrollment[]
  payouts RewardPayout[]
  @@index([status, createdAt])
}
model FeeClaim {
  id String @id @default(cuid())
  launchId String
  roundId String?
  signature String @unique
  source String
  grossLamports BigInt
  costLamports BigInt @default(0)
  claimedAt DateTime @default(now())
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  @@index([launchId, roundId, claimedAt])
}
model RewardEnrollment {
  id String @id @default(cuid())
  launchId String
  userId String
  xId String
  walletAddress String
  joinedAt DateTime @default(now())
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@unique([launchId, xId])
  @@index([launchId, userId])
}
model RewardRound {
  id String @id @default(cuid())
  launchId String
  raidId String
  startsAt DateTime
  endsAt DateTime
  status String @default("PENDING")
  grossLamports BigInt @default(0)
  costLamports BigInt @default(0)
  platformLamports BigInt @default(0)
  raiderLamports BigInt @default(0)
  settledAt DateTime?
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  @@unique([raidId, startsAt])
  @@index([launchId, endsAt])
}
model RewardPayout {
  id String @id @default(cuid())
  launchId String
  roundId String
  payoutBatchRoundId String?
  walletAddress String
  xId String
  score Int
  lamports BigInt
  status String @default("PENDING")
  signature String?
  createdAt DateTime @default(now())
  paidAt DateTime?
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  @@unique([roundId, xId])
  @@index([walletAddress, status])
  @@index([payoutBatchRoundId, status])
  @@index([signature])
}
model FinancialTx {
  id String @id @default(cuid())
  key String @unique
  launchId String
  roundId String?
  kind String
  raw String
  signature String @unique
  blockhash String
  lastValidBlockHeight Int
  status String @default("SIGNED")
  costLamports BigInt?
  createdAt DateTime @default(now())
  confirmedAt DateTime?
  @@index([launchId, status])
}
model Session {
  tokenHash String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model OAuthAttempt {
  stateHash String @id
  verifier String
  expiresAt DateTime
  userId String?
  sessionHash String?
  consumedAt DateTime?
  @@index([expiresAt])
  @@index([userId])
}
model XAccount {
  id String @id @default(cuid())
  userId String @unique
  xUserId String @unique
  username String
  displayName String
  profileImage String?
  connectedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Token {
  mint String @id
  symbol String
  name String
  raids Raid[]
  market Json?
  marketAt DateTime?
  marketError String?
}
model Raid {
  id String @id @default(cuid())
  tag String @unique
  title String
  description String
  mint String
  creatorId String
  tokenLaunchId String?
  status String @default("DRAFT")
  startsAt DateTime
  endsAt DateTime
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  observedAt DateTime?
  coveredUntil DateTime?
  coverage String @default("unavailable")
  collectionError String?
  sinceId String?
  nextToken String?
  searchEndAt DateTime?
  pendingNewestId String?
  finalRefreshed Boolean @default(false)
  token Token @relation(fields: [mint], references: [mint])
  creator User @relation(fields: [creatorId], references: [id])
  posts Post[]
  snapshots Snapshot[]
  tokenLaunch TokenLaunch? @relation("CurrentLaunchRaid")
  launch TokenLaunch? @relation("LaunchRaids", fields: [tokenLaunchId], references: [id])
  @@index([tokenLaunchId, startsAt])
  @@index([status, startsAt, endsAt])
}
model Post {
  id String @id
  raidId String
  authorId String
  text String
  normalized String
  createdAt DateTime
  observedAt DateTime
  likes Int @default(0)
  replies Int @default(0)
  reposts Int @default(0)
  quotes Int @default(0)
  hidden Boolean @default(false)
  deleted Boolean @default(false)
  raid Raid @relation(fields: [raidId], references: [id])
  @@index([raidId, createdAt])
  @@index([authorId])
}
model Snapshot {
  id String @id @default(cuid())
  raidId String
  at DateTime
  score Int
  raiders Int
  posts Int
  interactions Int
  complete Boolean
  scoreVersion Int @default(1)
  raid Raid @relation(fields: [raidId], references: [id])
  @@unique([raidId, at])
  @@index([raidId, at])
}
model Job {
  id String @id @default(cuid())
  key String @unique
  kind String
  payload Json
  runAt DateTime @default(now())
  lockedAt DateTime?
  lease String?
  attempts Int @default(0)
  error String?
  doneAt DateTime?
  @@index([doneAt, runAt, lockedAt])
}
model Settings {
  id String @id @default("global")
  collectionEnabled Boolean @default(false)
  maxActiveRaids Int @default(10)
  maxCreators Int @default(5)
  monthlyBudgetCents Int @default(20000)
  cutoffCents Int @default(18000)
  dailyRequestLimit Int @default(5000)
  launchPaused Boolean @default(false)
  payoutPaused Boolean @default(false)
  payoutWorkerAt DateTime?
  operatorAddress String?
}
model ProviderUsage {
  id String @id @default(cuid())
  at DateTime @default(now())
  provider String
  raidId String?
  units Int
  reservedCents Int
  reason String
  @@index([provider, at])
}
model RateLimit {
  key String @id
  count Int @default(0)
  expiresAt DateTime
}
model ModerationEvent {
  id String @id @default(cuid())
  actorId String
  action String
  targetId String
  reason String
  createdAt DateTime @default(now())
}
model Event {
  id String @id @default(cuid())
  type String
  raidId String?
  visitor String?
  at DateTime @default(now())
  @@index([type, at])
}
