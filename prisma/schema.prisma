generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  xId String? @unique
  handle String
  role String @default("CREATOR")
  approved Boolean @default(false)
  suspended Boolean @default(false)
  affiliation String @default("")
  createdAt DateTime @default(now())
  xAccount XAccount?
  sessions Session[]
  raids Raid[]
  wallet WalletIdentity?
  launches TokenLaunch[]
  enrollments RewardEnrollment[]
  raidEnrollments RaidEnrollment[]
  ledger BalanceEntry[]
  transfers UsdcTransfer[]
  usdcAllocations UsdcAllocation[]
}
model WalletIdentity {
  address String @id
  userId String @unique
  verifiedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model WalletChallenge {
  digest String @id
  address String
  message String
  expiresAt DateTime
  consumedAt DateTime?
  @@index([address, expiresAt])
}
model TokenLaunch {
  id String @id @default(cuid())
  userId String
  mint String @unique
  name String
  symbol String
  description String
  metadataUri String
  imageUri String
  bannerUri String?
  feeAddress String @unique
  feeSecret String
  mintSecret String
  preparedTx String?
  signedTx String?
  preparedHash String?
  blockhash String?
  lastValidBlockHeight Int?
  signature String? @unique
  status String @default("PREPARED")
  reservationExpiresAt DateTime?
  error String?
  raidId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  raid Raid? @relation("CurrentLaunchRaid", fields: [raidId], references: [id])
  raids Raid[] @relation("LaunchRaids")
  claims FeeClaim[]
  rounds RewardRound[]
  enrollments RewardEnrollment[]
  payouts RewardPayout[]
  @@index([status, createdAt])
}
model FeeClaim {
  id String @id @default(cuid())
  launchId String
  roundId String?
  raidId String?
  signature String @unique
  source String
  grossLamports BigInt
  costLamports BigInt @default(0)
  claimedAt DateTime @default(now())
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  @@index([launchId, roundId, claimedAt])
}
model RewardEnrollment {
  id String @id @default(cuid())
  launchId String
  userId String
  xId String
  walletAddress String
  joinedAt DateTime @default(now())
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@unique([launchId, xId])
  @@index([launchId, userId])
}
model RewardRound {
  id String @id @default(cuid())
  launchId String
  raidId String
  startsAt DateTime
  endsAt DateTime
  status String @default("PENDING")
  grossLamports BigInt @default(0)
  costLamports BigInt @default(0)
  platformLamports BigInt @default(0)
  raiderLamports BigInt @default(0)
  settledAt DateTime?
  resultSnapshotId String? @unique
  resultSnapshot CampaignResult? @relation(fields: [resultSnapshotId], references: [id])
  settlementRaidId String? @unique
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  @@unique([raidId, startsAt])
  @@index([launchId, endsAt])
}
model RewardPayout {
  id String @id @default(cuid())
  launchId String
  roundId String
  payoutBatchRoundId String?
  walletAddress String
  xId String
  score Int
  lamports BigInt
  status String @default("PENDING")
  signature String?
  createdAt DateTime @default(now())
  paidAt DateTime?
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  @@unique([roundId, xId])
  @@index([walletAddress, status])
  @@index([payoutBatchRoundId, status])
  @@index([signature])
}
model FinancialTx {
  id String @id @default(cuid())
  key String @unique
  launchId String
  roundId String?
  kind String
  raidId String?
  raw String
  signature String @unique
  blockhash String
  lastValidBlockHeight Int
  status String @default("SIGNED")
  costLamports BigInt?
  createdAt DateTime @default(now())
  confirmedAt DateTime?
  @@index([launchId, status])
}
model Session {
  tokenHash String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model OAuthAttempt {
  stateHash String @id
  verifier String
  expiresAt DateTime
  userId String?
  sessionHash String?
  consumedAt DateTime?
  @@index([expiresAt])
  @@index([userId])
}
model XAccount {
  id String @id @default(cuid())
  userId String @unique
  xUserId String @unique
  username String
  displayName String
  profileImage String?
  connectedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Token {
  mint String @id
  symbol String
  name String
  imageUri String?
  raids Raid[]
  market Json?
  marketAt DateTime?
  marketError String?
  metadataSource String @default("CREATOR")
  metadataVerifiedAt DateTime?
}
model Raid {
  id String @id @default(cuid())
  tag String @unique
  title String
  description String
  studioVersion Int @default(0)
  fundingAsset String @default("SOL")
  fundingNetwork String @default("mainnet")
  poolUnits BigInt?
  quoteRate BigInt?
  imageUri String?
  usdcAllocations UsdcAllocation[]
  mint String?
  projectName String @default("")
  projectSymbol String @default("")
  fundingStatus String @default("NOT_REQUIRED")
  fundingRequest String @default("")
  impressionTarget Int?
  fundingLamports String?
  fundingRecipient String?
  fundingSignature String? @unique
  fundedAt DateTime?
  fundingWallet String?
  allocations RaidAllocation[]
  targetReachedAt DateTime?
  briefPosts RaidBriefPost[]
  creatorId String
  tokenLaunchId String?
  status String @default("DRAFT")
  startsAt DateTime
  endsAt DateTime
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  observedAt DateTime?
  coveredUntil DateTime?
  coverage String @default("unavailable")
  collectionError String?
  sinceId String?
  nextToken String?
  searchEndAt DateTime?
  searchQuery String?
  pendingNewestId String?
  finalRefreshed Boolean @default(false)
  trackingVersion Int @default(1)
  ruleVersion Int @default(1)
  scoringVersion Int @default(1)
  officialHandle String @default("useRAID")
  trackingPhase String @default("COLLECTING")
  reviewEndsAt DateTime?
  activeResultId String?
  finalFeeSweepAt DateTime?
  holdReason String?
  authorCapBps Int @default(10000)
  measureUntil DateTime?
  enrollments RaidEnrollment[]
  submissions PostSubmission[]
  results CampaignResult[]
  disputes RaidDispute[]
  token Token? @relation(fields: [mint], references: [mint], onDelete: Restrict)
  creator User @relation(fields: [creatorId], references: [id])
  posts Post[]
  snapshots Snapshot[]
  tokenLaunch TokenLaunch? @relation("CurrentLaunchRaid")
  launch TokenLaunch? @relation("LaunchRaids", fields: [tokenLaunchId], references: [id])
  @@index([tokenLaunchId, startsAt])
  @@index([status, startsAt, endsAt])
}
model Post {
  id String @id
  raidId String
  authorId String
  text String
  normalized String
  contentHash String?
  createdAt DateTime
  observedAt DateTime
  likes Int @default(0)
  replies Int @default(0)
  reposts Int @default(0)
  quotes Int @default(0)
  views Int?
  hidden Boolean @default(false)
  deleted Boolean @default(false)
  enrollmentId String?
  targetPostId String?
  enrollment RaidEnrollment? @relation(fields: [enrollmentId], references: [id])
  source String @default("SEARCH")
  postType String @default("ORIGINAL")
  qualification String @default("LEGACY")
  reasonCode String?
  ruleVersion Int @default(1)
  availability String @default("AVAILABLE")
  reviewStatus String @default("CLEAR")
  reviewFingerprint String?
  adminExcluded Boolean @default(false)
  contentExpiredAt DateTime?
  lastObservationId String?
  observations MetricObservation[]
  decisions ContributionDecision[]
  raid Raid @relation(fields: [raidId], references: [id])
  @@index([raidId, createdAt])
  @@index([authorId])
}
model RaidBriefPost {
  id String @id @default(cuid())
  raidId String
  postId String
  createdAt DateTime @default(now())
  preview Json?
  validatedAt DateTime?
  raid Raid @relation(fields: [raidId], references: [id])
  @@unique([raidId, postId])
}
model RaidAllocation {
  id String @id @default(cuid())
  raidId String
  resultId String?
  kind String
  xId String?
  walletAddress String
  lamports String
  signature String? @unique
  paidAt DateTime?
  raid Raid @relation(fields: [raidId], references: [id])
  @@unique([raidId, kind, walletAddress])
}
model BalanceEntry {
  network       String @default("mainnet")
  id String @id @default(cuid())
  key String @unique
  userId String
  kind String
  availableDelta BigInt
  reservedDelta BigInt
  raidId String?
  transferId String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
}
model UsdcTransfer {
  id String @id @default(cuid())
  userId String
  kind String
  amount BigInt
  walletAddress String
  recipient String
  network String
  mint String
  status String @default("REQUESTED")
  signature String? @unique
  allocationId String? @unique
  createdAt DateTime @default(now())
  expiresAt DateTime?
  paidAt DateTime?
  user User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
  @@index([status, kind])
}
model UsdcAllocation {
  id String @id @default(cuid())
  raidId String
  resultId String
  userId String
  xId String
  walletAddress String
  amount BigInt
  raid Raid @relation(fields: [raidId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@unique([raidId, xId])
}
model Snapshot {
  id String @id @default(cuid())
  raidId String
  at DateTime
  score Int
  raiders Int
  posts Int
  interactions Int
  complete Boolean
  scoreVersion Int @default(1)
  raid Raid @relation(fields: [raidId], references: [id])
  @@unique([raidId, at])
  @@index([raidId, at])
}
model Job {
  id String @id @default(cuid())
  key String @unique
  kind String
  priority Int @default(0)
  payload Json
  runAt DateTime @default(now())
  lockedAt DateTime?
  lease String?
  attempts Int @default(0)
  error String?
  doneAt DateTime?
  failedAt DateTime?
  @@index([doneAt, runAt, lockedAt])
  @@index([failedAt])
}
model Settings {
  id String @id @default("global")
  collectionEnabled Boolean @default(false)
  maxActiveRaids Int @default(10)
  maxCreators Int @default(5)
  monthlyBudgetCents Int @default(20000)
  cutoffCents Int @default(18000)
  dailyRequestLimit Int @default(5000)
  identityDailyLimit Int @default(1000)
  launchPaused Boolean @default(false)
  payoutPaused Boolean @default(false)
  payoutWorkerAt DateTime?
  operatorAddress String?
}
model ProviderUsage {
  id String @id @default(cuid())
  at DateTime @default(now())
  provider String
  raidId String?
  units Int
  reservedCents Int
  reason String
  @@index([provider, at])
}
model RateLimit {
  key String @id
  count Int @default(0)
  expiresAt DateTime
}
model ModerationEvent {
  id String @id @default(cuid())
  actorId String
  action String
  targetId String
  reason String
  createdAt DateTime @default(now())
}
model Event {
  id String @id @default(cuid())
  type String
  raidId String?
  visitor String?
  at DateTime @default(now())
  @@index([type, at])
  @@index([type, visitor, at])
}

model RaidEnrollment {
  id String @id @default(cuid())
  raidId String
  userId String
  xId String
  walletAddress String
  joinedAt DateTime @default(now())
  raid Raid @relation(fields: [raidId], references: [id])
  user User @relation(fields: [userId], references: [id])
  posts Post[]
  submissions PostSubmission[]
  disputes RaidDispute[]
  @@unique([raidId, xId])
  @@unique([raidId, userId])
  @@unique([raidId, walletAddress])
}
model PostSubmission {
  id String @id @default(cuid())
  raidId String
  enrollmentId String
  postId String
  status String @default("QUEUED")
  reasonCode String?
  createdAt DateTime @default(now())
  raid Raid @relation(fields: [raidId], references: [id])
  enrollment RaidEnrollment @relation(fields: [enrollmentId], references: [id])
  @@unique([raidId, enrollmentId, postId])
  @@index([raidId, status])
}
model MetricObservation {
  id String @id @default(cuid())
  postId String
  sampleKey String
  observedAt DateTime @default(now())
  likes Int
  replies Int
  reposts Int
  quotes Int
  views Int?
  post Post @relation(fields: [postId], references: [id])
  @@unique([postId, sampleKey])
  @@index([postId, observedAt])
}
model ContributionDecision {
  id String @id @default(cuid())
  postId String
  actorId String?
  qualification String
  reasonCode String?
  ruleVersion Int
  evidence Json
  at DateTime @default(now())
  post Post @relation(fields: [postId], references: [id])
  @@index([postId, at])
}
model CampaignResult {
  id String @id @default(cuid())
  raidId String
  version Int
  fingerprint String
  settlement RewardRound?
  payload Json
  createdAt DateTime @default(now())
  raid Raid @relation(fields: [raidId], references: [id])
  @@unique([raidId, version])
}
model RaidDispute {
  id String @id @default(cuid())
  raidId String
  enrollmentId String
  resultId String
  postId String?
  category String
  reason String
  status String @default("OPEN")
  resolution String?
  actorId String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  raid Raid @relation(fields: [raidId], references: [id])
  enrollment RaidEnrollment @relation(fields: [enrollmentId], references: [id])
  @@index([raidId, status])
}
model XEndpointState {
  key String @id
  remaining Int?
  resetAt DateTime?
  blockedUntil DateTime?
  lastSuccessAt DateTime?
  lastError String?
}
