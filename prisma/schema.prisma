generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  xId String? @unique
  handle String
  role String @default("CREATOR")
  approved Boolean @default(false)
  suspended Boolean @default(false)
  affiliation String @default("")
  createdAt DateTime @default(now())
  xAccount XAccount?
  sessions Session[]
  raids Raid[]
  wallet WalletIdentity?
  launches TokenLaunch[]
  enrollments RewardEnrollment[]
  raidEnrollments RaidEnrollment[]
  ledger BalanceEntry[]
  transfers UsdcTransfer[]
  usdcAllocations UsdcAllocation[]
  mediaAssets MediaAsset[]
  participant Participant?
  walletLinks WalletLink[]
  raiderPreferences RaiderPreferences?
  raiderPreferenceVersions RaiderPreferenceVersion[]
  guildDrafts GuildDraft[]
  skillTaxonomyVersions SkillTaxonomyVersion[]
  practiceTrialVersions PracticeTrialVersion[]
}
// Immutable HUMAN foundation; checks/row guard live in the additive SQL migration.
model Participant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind String @default("HUMAN")
  accountId String @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  provisionActorAccountId String
  provisionRequestId String
  account User @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  walletLinks WalletLink[]
  raiderPreferences RaiderPreferences[]
  raiderPreferenceVersions RaiderPreferenceVersion[]
  skillClaims SkillClaim[]
  skillClaimVersions SkillClaimVersion[]
  @@unique([id, accountId])
  practiceStarts PracticeTrialStart[]
}
// Additional verified wallet credentials; checks, guard and exclusivity triggers live in the SQL migration.
model WalletLink {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String
  participantId String @db.Uuid
  networkIdentity String
  address String @unique
  status String @default("ACTIVE")
  proofRef String @unique
  verifiedAt DateTime @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  linkActorAccountId String
  linkRequestId String
  account User @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "WalletLink_accountId_fkey")
  participant Participant @relation(fields: [participantId, accountId], references: [id, accountId], onDelete: Restrict, onUpdate: Restrict, map: "WalletLink_participant_fkey")
  @@index([accountId, status])
}
// Exact instrument identity (T029). Checks, immutability and policy guards live in the additive SQL migration.
model Asset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chain String @default("SOLANA")
  networkIdentity String
  kind String
  mint String @default("")
  tokenProgram String @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  policySnapshots AssetPolicySnapshot[]
  @@unique([chain, networkIdentity, kind, mint, tokenProgram], map: "Asset_identity_key")
}
// Versioned policy observations for one Asset; never an identity (T029).
model AssetPolicySnapshot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId String @db.Uuid
  registryVersion String
  verifiedDecimals Int @db.SmallInt
  observedAuthorities String[] @default([])
  supportedExtensionProfile String
  observedAt DateTime @db.Timestamptz(6)
  observedSlot Decimal @db.Decimal(20, 0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([assetId, registryVersion])
}
model MediaAsset {
  id String @id @default(cuid())
  sha256 String @unique
  mime String
  bytes Bytes
  size Int
  uploaderId String?
  createdAt DateTime @default(now())
  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
}
model WalletIdentity {
  address String @id
  userId String @unique
  verifiedAt DateTime @default(now())
  previousAddress String?
  rotatedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model WalletChallenge {
  digest String @id
  address String
  message String
  userId String?
  expiresAt DateTime
  consumedAt DateTime?
  @@index([address, expiresAt])
}
model TokenLaunch {
  id String @id @default(cuid())
  userId String
  mint String @unique
  name String
  symbol String
  description String
  metadataUri String
  imageUri String
  bannerUri String?
  feeAddress String @unique
  feeSecret String
  mintSecret String
  preparedTx String?
  signedTx String?
  preparedHash String?
  blockhash String?
  lastValidBlockHeight Int?
  signature String? @unique
  status String @default("PREPARED")
  reservationExpiresAt DateTime?
  error String?
  rentReserveLamports BigInt @default(0)
  raidId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  raid Raid? @relation("CurrentLaunchRaid", fields: [raidId], references: [id])
  raids Raid[] @relation("LaunchRaids")
  claims FeeClaim[]
  rounds RewardRound[]
  enrollments RewardEnrollment[]
  payouts RewardPayout[]
  @@index([status, createdAt])
}
model FeeClaim {
  id String @id @default(cuid())
  launchId String
  roundId String?
  raidId String?
  signature String @unique
  source String
  grossLamports BigInt
  costLamports BigInt @default(0)
  claimedAt DateTime @default(now())
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  @@index([launchId, roundId, claimedAt])
}
model RewardEnrollment {
  id String @id @default(cuid())
  launchId String
  userId String
  xId String
  walletAddress String
  joinedAt DateTime @default(now())
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@unique([launchId, xId])
  @@index([launchId, userId])
}
model RewardRound {
  id String @id @default(cuid())
  launchId String
  raidId String
  startsAt DateTime
  endsAt DateTime
  status String @default("PENDING")
  grossLamports BigInt @default(0)
  costLamports BigInt @default(0)
  platformLamports BigInt @default(0)
  raiderLamports BigInt @default(0)
  settledAt DateTime?
  resultSnapshotId String? @unique
  resultSnapshot CampaignResult? @relation(fields: [resultSnapshotId], references: [id])
  settlementRaidId String? @unique
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  @@unique([raidId, startsAt])
  @@index([launchId, endsAt])
}
model RewardPayout {
  id String @id @default(cuid())
  launchId String
  roundId String
  payoutBatchRoundId String?
  walletAddress String
  xId String
  score Int
  lamports BigInt
  status String @default("PENDING")
  signature String?
  createdAt DateTime @default(now())
  paidAt DateTime?
  launch TokenLaunch @relation(fields: [launchId], references: [id])
  @@unique([roundId, xId])
  @@index([walletAddress, status])
  @@index([payoutBatchRoundId, status])
  @@index([signature])
}
model FinancialTx {
  id String @id @default(cuid())
  key String @unique
  launchId String
  roundId String?
  kind String
  raidId String?
  raw String
  signature String @unique
  blockhash String
  lastValidBlockHeight Int
  status String @default("SIGNED")
  costLamports BigInt?
  createdAt DateTime @default(now())
  confirmedAt DateTime?
  @@index([launchId, status])
  @@index([launchId, kind, roundId])
}
model Session {
  tokenHash String @id
  userId String
  expiresAt DateTime
  via String @default("x")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model OAuthAttempt {
  stateHash String @id
  verifier String
  expiresAt DateTime
  userId String?
  sessionHash String?
  consumedAt DateTime?
  @@index([expiresAt])
  @@index([userId])
}
model XAccount {
  id String @id @default(cuid())
  userId String @unique
  xUserId String @unique
  username String
  displayName String
  profileImage String?
  connectedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Token {
  mint String @id
  symbol String
  name String
  imageUri String?
  raids Raid[]
  market Json?
  marketAt DateTime?
  marketError String?
  metadataSource String @default("CREATOR")
  metadataVerifiedAt DateTime?
}
model Raid {
  id String @id @default(cuid())
  tag String @unique
  title String
  description String
  studioVersion Int @default(0)
  fundingAsset String @default("SOL")
  fundingNetwork String @default("mainnet")
  poolUnits BigInt?
  quoteRate BigInt?
  imageUri String?
  usdcAllocations UsdcAllocation[]
  balanceEntries BalanceEntry[]
  mint String?
  projectName String @default("")
  projectSymbol String @default("")
  fundingStatus String @default("NOT_REQUIRED")
  fundingRequest String @default("")
  impressionTarget Int?
  fundingLamports String?
  fundingRecipient String?
  fundingSignature String? @unique
  fundedAt DateTime?
  fundingWallet String?
  allocations RaidAllocation[]
  targetReachedAt DateTime?
  briefPosts RaidBriefPost[]
  creatorId String
  tokenLaunchId String?
  status String @default("DRAFT")
  startsAt DateTime
  endsAt DateTime
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  observedAt DateTime?
  coveredUntil DateTime?
  coverage String @default("unavailable")
  collectionError String?
  sinceId String?
  nextToken String?
  searchEndAt DateTime?
  searchQuery String?
  pendingNewestId String?
  finalRefreshed Boolean @default(false)
  trackingVersion Int @default(1)
  ruleVersion Int @default(1)
  scoringVersion Int @default(1)
  officialHandle String @default("useRAID")
  trackingPhase String @default("COLLECTING")
  reviewEndsAt DateTime?
  activeResultId String?
  finalFeeSweepAt DateTime?
  holdReason String?
  authorCapBps Int @default(10000)
  measureUntil DateTime?
  enrollments RaidEnrollment[]
  submissions PostSubmission[]
  results CampaignResult[]
  disputes RaidDispute[]
  token Token? @relation(fields: [mint], references: [mint], onDelete: Restrict)
  creator User @relation(fields: [creatorId], references: [id])
  posts Post[]
  snapshots Snapshot[]
  tokenLaunch TokenLaunch? @relation("CurrentLaunchRaid")
  launch TokenLaunch? @relation("LaunchRaids", fields: [tokenLaunchId], references: [id])
  @@index([tokenLaunchId, startsAt])
  @@index([status, startsAt, endsAt])
  @@index([creatorId, createdAt])
  @@index([mint])
}
model Post {
  id String @id
  raidId String
  authorId String
  text String
  normalized String
  contentHash String?
  createdAt DateTime
  observedAt DateTime
  likes Int @default(0)
  replies Int @default(0)
  reposts Int @default(0)
  quotes Int @default(0)
  views Int?
  hidden Boolean @default(false)
  deleted Boolean @default(false)
  enrollmentId String?
  targetPostId String?
  enrollment RaidEnrollment? @relation(fields: [enrollmentId], references: [id])
  source String @default("SEARCH")
  postType String @default("ORIGINAL")
  qualification String @default("LEGACY")
  reasonCode String?
  ruleVersion Int @default(1)
  availability String @default("AVAILABLE")
  reviewStatus String @default("CLEAR")
  reviewFingerprint String?
  adminExcluded Boolean @default(false)
  contentExpiredAt DateTime?
  lastObservationId String?
  observations MetricObservation[]
  decisions ContributionDecision[]
  raid Raid @relation(fields: [raidId], references: [id])
  @@index([raidId, createdAt])
  @@index([authorId])
}
model RaidBriefPost {
  id String @id @default(cuid())
  raidId String
  postId String
  createdAt DateTime @default(now())
  preview Json?
  validatedAt DateTime?
  raid Raid @relation(fields: [raidId], references: [id])
  @@unique([raidId, postId])
}
model RaidAllocation {
  id String @id @default(cuid())
  raidId String
  resultId String?
  kind String
  xId String?
  walletAddress String
  lamports String
  signature String? @unique
  paidAt DateTime?
  raid Raid @relation(fields: [raidId], references: [id])
  result CampaignResult? @relation(fields: [resultId], references: [id], onDelete: Restrict)
  @@unique([raidId, kind, walletAddress])
  @@index([resultId])
}
model BalanceEntry {
  network       String @default("mainnet")
  id String @id @default(cuid())
  key String @unique
  userId String
  kind String
  availableDelta BigInt
  reservedDelta BigInt
  raidId String?
  transferId String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  raid Raid? @relation(fields: [raidId], references: [id], onDelete: Restrict)
  transfer UsdcTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([userId, network])
  @@index([raidId])
}
model UsdcTransfer {
  id String @id @default(cuid())
  userId String
  kind String
  amount BigInt
  walletAddress String
  recipient String
  network String
  mint String
  status String @default("REQUESTED")
  signature String? @unique
  allocationId String? @unique
  createdAt DateTime @default(now())
  expiresAt DateTime?
  paidAt DateTime?
  user User @relation(fields: [userId], references: [id])
  allocation UsdcAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  entries BalanceEntry[]
  @@index([userId, createdAt])
  @@index([status, kind])
}
model UsdcAllocation {
  id String @id @default(cuid())
  raidId String
  resultId String
  userId String
  xId String
  walletAddress String
  amount BigInt
  raid Raid @relation(fields: [raidId], references: [id])
  user User @relation(fields: [userId], references: [id])
  result CampaignResult @relation(fields: [resultId], references: [id])
  transfer UsdcTransfer?
  @@unique([raidId, xId])
  @@index([resultId])
}
model Snapshot {
  id String @id @default(cuid())
  raidId String
  at DateTime
  score Int
  raiders Int
  posts Int
  interactions Int
  complete Boolean
  scoreVersion Int @default(1)
  raid Raid @relation(fields: [raidId], references: [id])
  @@unique([raidId, at])
  @@index([raidId, at])
}
model Job {
  id String @id @default(cuid())
  key String @unique
  kind String
  priority Int @default(0)
  payload Json
  runAt DateTime @default(now())
  lockedAt DateTime?
  lease String?
  attempts Int @default(0)
  error String?
  doneAt DateTime?
  failedAt DateTime?
  @@index([doneAt, runAt, lockedAt])
  @@index([failedAt])
}
model Settings {
  id String @id @default("global")
  collectionEnabled Boolean @default(false)
  maxActiveRaids Int @default(10)
  maxCreators Int @default(5)
  monthlyBudgetCents Int @default(20000)
  cutoffCents Int @default(18000)
  dailyRequestLimit Int @default(5000)
  identityDailyLimit Int @default(1000)
  launchPaused Boolean @default(false)
  payoutPaused Boolean @default(false)
  payoutWorkerAt DateTime?
  operatorAddress String?
}
model ProviderUsage {
  id String @id @default(cuid())
  at DateTime @default(now())
  provider String
  raidId String?
  units Int
  reservedCents Int
  reason String
  @@index([provider, at])
}
model RateLimit {
  key String @id
  count Int @default(0)
  expiresAt DateTime
}
model ModerationEvent {
  id String @id @default(cuid())
  actorId String
  action String
  targetId String
  reason String
  createdAt DateTime @default(now())
}
model Event {
  id String @id @default(cuid())
  type String
  raidId String?
  visitor String?
  at DateTime @default(now())
  @@index([type, at])
  @@index([type, visitor, at])
}

model RaidEnrollment {
  id String @id @default(cuid())
  raidId String
  userId String
  xId String
  walletAddress String
  joinedAt DateTime @default(now())
  raid Raid @relation(fields: [raidId], references: [id])
  user User @relation(fields: [userId], references: [id])
  posts Post[]
  submissions PostSubmission[]
  disputes RaidDispute[]
  @@unique([raidId, xId])
  @@unique([raidId, userId])
  @@unique([raidId, walletAddress])
  @@index([xId, joinedAt])
}
model PostSubmission {
  id String @id @default(cuid())
  raidId String
  enrollmentId String
  postId String
  status String @default("QUEUED")
  reasonCode String?
  createdAt DateTime @default(now())
  raid Raid @relation(fields: [raidId], references: [id])
  enrollment RaidEnrollment @relation(fields: [enrollmentId], references: [id])
  @@unique([raidId, enrollmentId, postId])
  @@index([raidId, status])
}
model MetricObservation {
  id String @id @default(cuid())
  postId String
  sampleKey String
  observedAt DateTime @default(now())
  likes Int
  replies Int
  reposts Int
  quotes Int
  views Int?
  post Post @relation(fields: [postId], references: [id])
  @@unique([postId, sampleKey])
  @@index([postId, observedAt])
}
model ContributionDecision {
  id String @id @default(cuid())
  postId String
  actorId String?
  qualification String
  reasonCode String?
  ruleVersion Int
  evidence Json
  at DateTime @default(now())
  post Post @relation(fields: [postId], references: [id])
  @@index([postId, at])
}
model CampaignResult {
  id String @id @default(cuid())
  raidId String
  version Int
  fingerprint String
  settlement RewardRound?
  usdcAllocations UsdcAllocation[]
  raidAllocations RaidAllocation[]
  payload Json
  createdAt DateTime @default(now())
  raid Raid @relation(fields: [raidId], references: [id])
  @@unique([raidId, version])
}
model RaidDispute {
  id String @id @default(cuid())
  raidId String
  enrollmentId String
  resultId String
  postId String?
  category String
  reason String
  status String @default("OPEN")
  resolution String?
  actorId String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  raid Raid @relation(fields: [raidId], references: [id])
  enrollment RaidEnrollment @relation(fields: [enrollmentId], references: [id])
  @@index([raidId, status])
}
model XEndpointState {
  key String @id
  remaining Int?
  resetAt DateTime?
  blockedUntil DateTime?
  lastSuccessAt DateTime?
  lastError String?
}
// Command receipts, audit and outbox foundation (T019). Checks, triggers and immutability live in the
// additive SQL migration 202610090001_command_receipts; Prisma only mirrors columns, keys and indexes.
model CommandReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String
  commandKind String
  idempotencyKey String
  requestDigest String
  requestId String
  resultRef String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  auditEvents AuditEvent[]
  orientationVersion RaiderPreferenceVersion?
  guildDraftVersion GuildDraftVersion?
  projectProposalVersion GuildProjectProposalVersion?
  skillTaxonomyVersion SkillTaxonomyVersion?
  skillClaimVersion SkillClaimVersion?
  practiceTrialVersion PracticeTrialVersion?
  @@unique([actorId, commandKind, idempotencyKey])
  practiceTrialStart PracticeTrialStart?
}
model InboxDelivery {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider String
  deliveryId String
  payloadDigest String
  resultRef String?
  receivedAt DateTime @default(now()) @db.Timestamptz(6)
  auditEvents AuditEvent[]
  @@unique([provider, deliveryId])
}
model AuditEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId String? @db.Uuid
  inboxId String? @db.Uuid
  ordinal Int
  eventType String
  aggregateId String
  aggregateVersion Int
  actorId String
  guildId String?
  correlationId String
  payload Json @db.JsonB
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  receipt CommandReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inbox InboxDelivery? @relation(fields: [inboxId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  outbox OutboxEvent?
  @@unique([receiptId, ordinal])
  @@unique([inboxId, ordinal])
  @@index([aggregateId, occurredAt])
}
model OutboxEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  event AuditEvent @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([createdAt])
}

// Private unpaid orientation. Payload/identity/revision/commit guards live in the additive SQL migration.
model RaiderPreferenceVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String
  participantId String @db.Uuid
  revision Int
  preferences Json @db.JsonB
  receiptId String @unique(map: "RaiderPreferenceVersion_receiptId_key") @db.Uuid
  actorAccountId String
  requestId String
  recordedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  account User @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "RaiderPreferenceVersion_account_fkey")
  participant Participant @relation(fields: [participantId, accountId], references: [id, accountId], onDelete: Restrict, onUpdate: Restrict, map: "RaiderPreferenceVersion_participant_fkey")
  receipt CommandReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "RaiderPreferenceVersion_receipt_fkey")
  currentProjections RaiderPreferences[]
  @@unique([accountId, revision], map: "RaiderPreferenceVersion_account_revision_key")
  @@unique([id, accountId, participantId, revision], map: "RaiderPreferenceVersion_pointer_key")
}
model RaiderPreferences {
  accountId String @id
  participantId String @db.Uuid
  revision Int
  currentVersionId String @db.Uuid
  account User @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "RaiderPreferences_account_fkey")
  participant Participant @relation(fields: [participantId, accountId], references: [id, accountId], onDelete: Restrict, onUpdate: Restrict, map: "RaiderPreferences_participant_fkey")
  currentVersion RaiderPreferenceVersion @relation(fields: [currentVersionId, accountId, participantId, revision], references: [id, accountId, participantId, revision], onDelete: Restrict, onUpdate: Restrict, map: "RaiderPreferences_version_fkey")
}
// Private draft ownership is not verified project-Founder/Guild permission authority.
model GuildDraft {
  id String @id @db.Uuid
  ownerAccountId String
  slug String @unique(map: "GuildDraft_slug_key")
  revision Int
  currentVersionId String @db.Uuid
  owner User @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "GuildDraft_owner_fkey")
  versions GuildDraftVersion[] @relation("GuildDraftHistory")
  projectProposal GuildProjectProposal?
  currentVersion GuildDraftVersion @relation("GuildDraftCurrent", fields: [currentVersionId, id, ownerAccountId, revision], references: [id, guildDraftId, ownerAccountId, revision], onDelete: Restrict, onUpdate: Restrict, map: "GuildDraft_version_fkey")
  @@unique([id, ownerAccountId], map: "GuildDraft_owner_key")
  @@index([ownerAccountId])
}
model GuildDraftVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guildDraftId String @db.Uuid
  ownerAccountId String
  revision Int
  profile Json @db.JsonB
  receiptId String @unique(map: "GuildDraftVersion_receiptId_key") @db.Uuid
  actorAccountId String
  requestId String
  recordedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  draft GuildDraft @relation("GuildDraftHistory", fields: [guildDraftId, ownerAccountId], references: [id, ownerAccountId], onDelete: Restrict, onUpdate: Restrict, map: "GuildDraftVersion_draft_fkey")
  currentProjections GuildDraft[] @relation("GuildDraftCurrent")
  projectProposals GuildProjectProposalVersion[] @relation("ProjectProposalDraft")
  receipt CommandReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "GuildDraftVersion_receipt_fkey")
  @@unique([guildDraftId, revision], map: "GuildDraftVersion_draft_revision_key")
  @@unique([id, guildDraftId, ownerAccountId, revision], map: "GuildDraftVersion_pointer_key")
}

// Pending self-described project claims never create a verified Guild/token relationship.
model GuildProjectProposal {
  guildDraftId String @id @db.Uuid
  ownerAccountId String
  revision Int
  currentVersionId String @db.Uuid
  draft GuildDraft @relation(fields: [guildDraftId, ownerAccountId], references: [id, ownerAccountId], onDelete: Restrict, onUpdate: Restrict, map: "GuildProjectProposal_draft_fkey")
  versions GuildProjectProposalVersion[] @relation("ProjectProposalHistory")
  currentVersion GuildProjectProposalVersion @relation("ProjectProposalCurrent", fields: [currentVersionId, guildDraftId, ownerAccountId, revision], references: [id, guildDraftId, ownerAccountId, revision], onDelete: Restrict, onUpdate: Restrict, map: "GuildProjectProposal_version_fkey")
  @@unique([guildDraftId, ownerAccountId], map: "GuildProjectProposal_owner_key")
}
model GuildProjectProposalVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guildDraftId String @db.Uuid
  ownerAccountId String
  revision Int
  draftVersionId String @db.Uuid
  draftRevision Int
  candidateToken Json @db.JsonB
  publicEvidenceRefs Json @db.JsonB
  receiptId String @unique(map: "GuildProjectProposalVersion_receiptId_key") @db.Uuid
  actorAccountId String
  requestId String
  recordedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  proposal GuildProjectProposal @relation("ProjectProposalHistory", fields: [guildDraftId, ownerAccountId], references: [guildDraftId, ownerAccountId], onDelete: Restrict, onUpdate: Restrict, map: "GuildProjectProposalVersion_proposal_fkey")
  currentProjections GuildProjectProposal[] @relation("ProjectProposalCurrent")
  draftSnapshot GuildDraftVersion @relation("ProjectProposalDraft", fields: [draftVersionId, guildDraftId, ownerAccountId, draftRevision], references: [id, guildDraftId, ownerAccountId, revision], onDelete: Restrict, onUpdate: Restrict, map: "GuildProjectProposalVersion_draft_fkey")
  receipt CommandReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "GuildProjectProposalVersion_receipt_fkey")
  @@unique([guildDraftId, revision], map: "GuildProjectProposalVersion_revision_key")
  @@unique([id, guildDraftId, ownerAccountId, revision], map: "GuildProjectProposalVersion_pointer_key")
}

// Admin-published catalog history; validation/immutability/receipt guards live in additive SQL.
model SkillTaxonomy {
  id String @id
  revision Int
  currentVersionId String @db.Uuid
  currentVersion SkillTaxonomyVersion @relation("SkillTaxonomyPointer", fields: [currentVersionId, id, revision], references: [id, taxonomyId, revision], onDelete: Restrict, onUpdate: Restrict, map: "SkillTaxonomy_version_fkey")
  versions SkillTaxonomyVersion[] @relation("SkillTaxonomyHistory")
}
model SkillTaxonomyVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxonomyId String
  revision Int
  skills Json @db.JsonB
  receiptId String @unique(map: "SkillTaxonomyVersion_receiptId_key") @db.Uuid
  publishedByAccountId String
  requestId String
  publishedAt DateTime @default(dbgenerated("date_trunc('milliseconds'::text, clock_timestamp())")) @db.Timestamptz(3)
  taxonomy SkillTaxonomy @relation("SkillTaxonomyHistory", fields: [taxonomyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "SkillTaxonomyVersion_catalog_fkey")
  currentFor SkillTaxonomy[] @relation("SkillTaxonomyPointer")
  skillClaimVersions SkillClaimVersion[]
  practiceTrialVersions PracticeTrialVersion[]
  publisher User @relation(fields: [publishedByAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "SkillTaxonomyVersion_actor_fkey")
  receipt CommandReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "SkillTaxonomyVersion_receipt_fkey")
  @@unique([taxonomyId, revision], map: "SkillTaxonomyVersion_revision_key")
  @@unique([id, taxonomyId, revision], map: "SkillTaxonomyVersion_pointer_key")
  practiceStarts PracticeTrialStart[]
}

// Private claimant-controlled versions, separate from assessments/ranks/history.
model SkillClaim {
  id String @id @db.Uuid
  accountId String
  participantId String @db.Uuid
  skillId String
  skillDomain String
  taxonomyId String
  revision Int
  currentVersionId String @db.Uuid
  participant Participant @relation(fields: [participantId, accountId], references: [id, accountId], onDelete: Restrict, onUpdate: Restrict, map: "SkillClaim_participant_fkey")
  currentVersion SkillClaimVersion @relation("SkillClaimPointer", fields: [currentVersionId, id, participantId, accountId, skillId, skillDomain, taxonomyId, revision], references: [id, skillClaimId, participantId, accountId, skillId, skillDomain, taxonomyId, revision], onDelete: Restrict, onUpdate: Restrict, map: "SkillClaim_version_fkey")
  versions SkillClaimVersion[] @relation("SkillClaimHistory")
  @@unique([participantId, skillId], map: "SkillClaim_subject_skill_key")
  @@unique([id, participantId, accountId, skillId, skillDomain, taxonomyId], map: "SkillClaim_owner_key")
}
model SkillClaimVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillClaimId String @db.Uuid
  accountId String
  participantId String @db.Uuid
  skillId String
  skillDomain String
  taxonomyId String
  taxonomyVersionId String @db.Uuid
  taxonomyRevision Int
  revision Int
  claimedLevel String
  supportingReferences Json @db.JsonB
  receiptId String @unique(map: "SkillClaimVersion_receiptId_key") @db.Uuid
  actorAccountId String
  requestId String
  recordedAt DateTime @default(dbgenerated("date_trunc('milliseconds'::text, clock_timestamp())")) @db.Timestamptz(3)
  claim SkillClaim @relation("SkillClaimHistory", fields: [skillClaimId, participantId, accountId, skillId, skillDomain, taxonomyId], references: [id, participantId, accountId, skillId, skillDomain, taxonomyId], onDelete: Restrict, onUpdate: Restrict, map: "SkillClaimVersion_claim_fkey")
  currentFor SkillClaim[] @relation("SkillClaimPointer")
  participant Participant @relation(fields: [participantId, accountId], references: [id, accountId], onDelete: Restrict, onUpdate: Restrict, map: "SkillClaimVersion_participant_fkey")
  taxonomyVersion SkillTaxonomyVersion @relation(fields: [taxonomyVersionId, taxonomyId, taxonomyRevision], references: [id, taxonomyId, revision], onDelete: Restrict, onUpdate: Restrict, map: "SkillClaimVersion_taxonomy_fkey")
  receipt CommandReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "SkillClaimVersion_receipt_fkey")
  @@unique([skillClaimId, revision], map: "SkillClaimVersion_revision_key")
  @@unique([id, skillClaimId, participantId, accountId, skillId, skillDomain, taxonomyId, revision], map: "SkillClaimVersion_pointer_key")
}

// Safe admin-published practice definitions/rubrics; no attempts, assessments or rank grants.
model PracticeTrial {
  id String @id
  skillId String
  skillDomain String
  taxonomyId String
  revision Int
  currentVersionId String @db.Uuid
  currentVersion PracticeTrialVersion @relation("PracticeTrialPointer", fields: [currentVersionId, id, skillId, skillDomain, taxonomyId, revision], references: [id, trialId, skillId, skillDomain, taxonomyId, revision], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrial_version_fkey")
  versions PracticeTrialVersion[] @relation("PracticeTrialHistory")
  @@unique([id, skillId, skillDomain, taxonomyId], map: "PracticeTrial_family_key")
  practiceStarts PracticeTrialStart[]
}
model SkillRubricVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rubricId String
  revision Int
  criteria Json @db.JsonB
  introducedByTrialVersionId String @unique(map: "SkillRubricVersion_introduction_key") @db.Uuid
  introducedBy PracticeTrialVersion @relation("PracticeRubricIntroduction", fields: [introducedByTrialVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "SkillRubricVersion_introduction_fkey")
  uses PracticeTrialVersion[] @relation("PracticeRubricUse")
  @@unique([rubricId, revision], map: "SkillRubricVersion_revision_key")
  @@unique([id, rubricId, revision], map: "SkillRubricVersion_pointer_key")
}
model PracticeTrialVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trialId String
  revision Int
  skillId String
  skillDomain String
  taxonomyId String
  taxonomyRevision Int
  taxonomyVersionId String @db.Uuid
  rubricId String
  rubricRevision Int
  rubricVersionId String @db.Uuid
  definition Json @db.JsonB
  availability String
  receiptId String @unique(map: "PracticeTrialVersion_receipt_key") @db.Uuid
  publishedByAccountId String
  requestId String
  publishedAt DateTime @default(dbgenerated("date_trunc('milliseconds'::text, clock_timestamp())")) @db.Timestamptz(3)
  trial PracticeTrial @relation("PracticeTrialHistory", fields: [trialId, skillId, skillDomain, taxonomyId], references: [id, skillId, skillDomain, taxonomyId], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrialVersion_family_fkey")
  currentFor PracticeTrial[] @relation("PracticeTrialPointer")
  taxonomyVersion SkillTaxonomyVersion @relation(fields: [taxonomyVersionId, taxonomyId, taxonomyRevision], references: [id, taxonomyId, revision], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrialVersion_taxonomy_fkey")
  rubricVersion SkillRubricVersion @relation("PracticeRubricUse", fields: [rubricVersionId, rubricId, rubricRevision], references: [id, rubricId, revision], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrialVersion_rubric_fkey")
  introducedRubric SkillRubricVersion? @relation("PracticeRubricIntroduction")
  publisher User @relation(fields: [publishedByAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrialVersion_actor_fkey")
  receipt CommandReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrialVersion_receipt_fkey")
  @@unique([trialId, revision], map: "PracticeTrialVersion_revision_key")
  @@unique([id, trialId, skillId, skillDomain, taxonomyId, revision], map: "PracticeTrialVersion_pointer_key")
  practiceStarts PracticeTrialStart[]
}

// Immutable historical practice starts; constraints/retry/receipt guards live in migration29.
model PracticeTrialStart {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId String @db.Uuid
  accountId String
  trialId String
  definitionVersionId String @db.Uuid
  taxonomyId String
  taxonomyRevision Int
  taxonomyVersionId String @db.Uuid
  attemptNumber Int
  startedAt DateTime @default(dbgenerated("date_trunc('milliseconds'::text, clock_timestamp())")) @db.Timestamptz(3)
  receiptId String @unique(map: "PracticeTrialStart_receipt_key") @db.Uuid
  requestId String
  participant Participant @relation(fields: [participantId, accountId], references: [id, accountId], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrialStart_participant_fkey")
  trial PracticeTrial @relation(fields: [trialId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrialStart_trial_fkey")
  definitionVersion PracticeTrialVersion @relation(fields: [definitionVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrialStart_definition_fkey")
  taxonomyVersion SkillTaxonomyVersion @relation(fields: [taxonomyVersionId, taxonomyId, taxonomyRevision], references: [id, taxonomyId, revision], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrialStart_taxonomy_fkey")
  receipt CommandReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "PracticeTrialStart_receipt_fkey")
  @@unique([participantId, trialId, attemptNumber], map: "PracticeTrialStart_family_number_key")
}
