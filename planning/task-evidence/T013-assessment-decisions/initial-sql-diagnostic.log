	ALTER TABLE "SkillAssessmentVersion" ADD CONSTRAINT "SkillAssessmentVersion_decision_fkey" FOREIGN KEY("decisionId") REFERENCES "PracticeAssessmentDecision"("id") ON DELETE RESTRICT ON UPDATE RESTRICT;
	CREATE FUNCTION raid_assessment_decision_guard_v1() RETURNS trigger LANGUAGE plpgsql AS $$
	DECLARE prior "SkillAssessmentVersion"%ROWTYPE;
	BEGIN
	 IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'Assessment decision history is immutable' USING ERRCODE='23000'; END IF;
	 SELECT * INTO prior FROM "SkillAssessmentVersion" WHERE "id"=NEW."priorAssessmentVersionId";
	 IF prior."id" IS NULL THEN RAISE EXCEPTION 'Decision requires actual committed source' USING ERRCODE='23000'; END IF;
	 PERFORM 1 FROM "User" WHERE "id"=NEW."evaluatorAccountId" FOR NO KEY UPDATE;
	 PERFORM pg_advisory_xact_lock(hashtextextended(NEW."assignmentId"::text,12017));
	 PERFORM pg_advisory_xact_lock(hashtextextended(prior."definitionVersionId"::text||':ASSESSMENT_REVIEW',12019));
	 PERFORM pg_advisory_xact_lock(hashtextextended(prior."submissionId"::text,12020));
	 PERFORM pg_advisory_xact_lock(hashtextextended(prior."participantId"::text||':'||prior."skillId",12022));
	 IF NEW."assessmentId"<>prior."assessmentId" OR NOT EXISTS(SELECT 1 FROM "SkillAssessment" WHERE "id"=prior."assessmentId" AND "currentVersionId"=prior."id" AND "revision"=prior."revision") OR prior."state"='REVOKED' OR (NEW."action"='REQUIRE_REASSESSMENT' AND prior."state"<>'VERIFIED') OR NEW."decidedAt"<prior."issuedAt" OR NEW."decidedAt">clock_timestamp() OR NEW."ownershipVersionId" IS DISTINCT FROM (SELECT "currentVersionId" FROM "PracticeTrialOwnership" WHERE "submissionId"=prior."submissionId") OR NEW."caseReviewVersionId" IS DISTINCT FROM (SELECT "currentVersionId" FROM "PracticeAssessmentReview" WHERE "submissionId"=prior."submissionId") THEN RAISE EXCEPTION 'Decision requires exact current source/state/case/clock' USING ERRCODE='23000'; END IF;
	 IF NOT EXISTS(SELECT 1 FROM "PracticeTrialSubmission" s JOIN "PracticeTrialReviewAssignment" g ON g."id"=NEW."assignmentId" AND g."submissionId"=s."id" AND g."purpose"='ASSESSMENT_REVIEW' AND g."evaluatorAccountId"=NEW."evaluatorAccountId" AND g."issuedAt"<=NEW."decidedAt" AND g."expiresAt">clock_timestamp() JOIN "User" u ON u."id"=g."evaluatorAccountId" AND u."suspended"=false JOIN "PracticeReviewPolicyVersion" v ON v."id"=NEW."policyVersionId" AND v."definitionVersionId"=prior."definitionVersionId" AND v."purpose"='ASSESSMENT_REVIEW' AND v."state"='APPROVED' AND v."publishedAt"<=NEW."decidedAt" JOIN "PracticeReviewPolicy" p ON p."currentVersionId"=v."id" JOIN "CommandReceipt" c ON c."id"=NEW."receiptId" AND date_trunc('milliseconds',c."createdAt")<=NEW."decidedAt" WHERE s."id"=prior."submissionId" AND s."accountId"<>g."evaluatorAccountId" AND NOT EXISTS(SELECT 1 FROM "PracticeTrialReviewRevocation" x WHERE x."assignmentId"=g."id")) THEN RAISE EXCEPTION 'Decision requires current actual nonself case authority/policy' USING ERRCODE='23000'; END IF;
	 RETURN NEW;
	END;
	$$;
	CREATE TRIGGER assessment_decision_guard_v1 BEFORE INSERT OR UPDATE OR DELETE ON "PracticeAssessmentDecision" FOR EACH ROW EXECUTE FUNCTION raid_assessment_decision_guard_v1();
	CREATE OR REPLACE FUNCTION raid_skill_assessment_version_guard_v1() RETURNS trigger LANGUAGE plpgsql AS $$
	DECLARE decision "PracticeAssessmentDecision"%ROWTYPE; prior "SkillAssessmentVersion"%ROWTYPE;
	BEGIN
	 IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'Committed skill assessment history is immutable' USING ERRCODE='23000'; END IF;
	 PERFORM pg_advisory_xact_lock(hashtextextended(NEW."participantId"::text||':'||NEW."skillId",12022));
	 IF NEW."revision">1 AND NOT EXISTS(SELECT 1 FROM "SkillAssessmentVersion" WHERE "assessmentId"=NEW."assessmentId" AND "revision"=NEW."revision"-1 AND "participantId"=NEW."participantId" AND "skillId"=NEW."skillId" AND "skillDomain"=NEW."skillDomain" AND "taxonomyId"=NEW."taxonomyId" AND "issuedAt"<=NEW."issuedAt") THEN RAISE EXCEPTION 'Assessment requires contiguous stable source history' USING ERRCODE='23000'; END IF;
	 IF NEW."decisionId" IS NOT NULL THEN
	  SELECT * INTO decision FROM "PracticeAssessmentDecision" WHERE "id"=NEW."decisionId";
	  SELECT * INTO prior FROM "SkillAssessmentVersion" WHERE "id"=decision."priorAssessmentVersionId";
	  IF decision."id" IS NULL OR prior."id" IS NULL OR NEW."id"<>decision."resultAssessmentVersionId" OR NEW."assessmentId"<>prior."assessmentId" OR NEW."participantId"<>prior."participantId" OR NEW."skillId"<>prior."skillId" OR NEW."skillDomain"<>prior."skillDomain" OR NEW."taxonomyId"<>prior."taxonomyId" OR NEW."revision"<>prior."revision"+1 OR NEW."assessedRank"<>prior."assessedRank" OR NEW."definitionVersionId"<>prior."definitionVersionId" OR NEW."submissionId"<>prior."submissionId" OR NEW."ownershipVersionId"<>prior."ownershipVersionId" OR NEW."reviewVersionId"<>prior."reviewVersionId" OR NEW."confidenceStatement"<>prior."confidenceStatement" OR NEW."sampleSize"<>prior."sampleSize" OR NEW."policyVersionId"<>decision."policyVersionId" OR NEW."evaluatorAccountId"<>decision."evaluatorAccountId" OR NEW."issuedAt"<>decision."decidedAt" OR NEW."reassessmentAt" IS DISTINCT FROM decision."dueAt" OR NEW."receiptId"<>decision."receiptId" OR NEW."requestId"<>decision."requestId" OR NEW."state"<>CASE WHEN decision."action"='REVOKE' THEN 'REVOKED' ELSE 'REASSESSMENT_REQUIRED' END THEN RAISE EXCEPTION 'Decision assessment requires exact preserved original lineage and attributable case' USING ERRCODE='23000'; END IF;
	  RETURN NEW;
	 END IF;
	 IF NOT EXISTS(SELECT 1 FROM "PracticeAssessmentReviewVersion" r JOIN "PracticeTrialSubmission" s ON s."id"=r."submissionId" AND s."participantId"=NEW."participantId" JOIN "PracticeTrialVersion" d ON d."id"=r."definitionVersionId" AND d."taxonomyId"=NEW."taxonomyId" AND d."definition"->>'skillId'=NEW."skillId" AND d."definition"->>'skillDomain'=NEW."skillDomain" AND d."definition"->>'targetRank'=NEW."assessedRank" WHERE r."id"=NEW."reviewVersionId" AND r."assessmentVersionId"=NEW."id" AND r."decision"='VERIFY' AND r."definitionVersionId"=NEW."definitionVersionId" AND r."submissionId"=NEW."submissionId" AND r."ownershipVersionId"=NEW."ownershipVersionId" AND r."policyVersionId"=NEW."policyVersionId" AND r."evaluatorAccountId"=NEW."evaluatorAccountId" AND r."reviewedAt"=NEW."issuedAt" AND r."reassessmentAt" IS NOT DISTINCT FROM NEW."reassessmentAt" AND r."confidenceStatement"=NEW."confidenceStatement" AND r."receiptId"=NEW."receiptId" AND r."requestId"=NEW."requestId") THEN RAISE EXCEPTION 'Verification requires exact attributable actual review source' USING ERRCODE='23000'; END IF;
	 RETURN NEW;
	END;
	$$;
	CREATE OR REPLACE FUNCTION raid_skill_assessment_commit_v1() RETURNS trigger LANGUAGE plpgsql AS $$
	BEGIN
	 IF NEW."decisionId" IS NOT NULL THEN
	  IF NOT EXISTS(SELECT 1 FROM "PracticeAssessmentDecision" d JOIN "CommandReceipt" c ON c."id"=d."receiptId" JOIN "AuditEvent" a ON a."receiptId"=c."id" JOIN "SkillAssessment" p ON p."id"=NEW."assessmentId" AND p."revision">=NEW."revision" WHERE d."id"=NEW."decisionId" AND d."resultAssessmentVersionId"=NEW."id" AND c."commandKind"='RecordPracticeAssessmentDecision' AND c."actorId"=NEW."evaluatorAccountId" AND c."requestId"=NEW."requestId" AND c."resultRef"=d."id"::text AND a."ordinal"=1 AND a."eventType"=CASE WHEN d."action"='REVOKE' THEN 'skill.assessment_revoked.v1' ELSE 'skill.assessment_reassessment_required.v1' END AND a."aggregateId"=NEW."assessmentId"::text AND a."aggregateVersion"=NEW."revision" AND a."actorId"=NEW."evaluatorAccountId" AND a."correlationId"=NEW."requestId" AND a."guildId" IS NULL AND a."payload"=jsonb_build_object('practiceAssessmentDecisionId',d."id"::text) AND NOT EXISTS(SELECT 1 FROM "OutboxEvent" o WHERE o."eventId"=a."id")) THEN RAISE EXCEPTION 'Decision assessment requires exact finalized private event' USING ERRCODE='23000'; END IF;
	  RETURN NULL;
	 END IF;
	 IF NOT EXISTS(SELECT 1 FROM "CommandReceipt" c JOIN "AuditEvent" a ON a."receiptId"=c."id" JOIN "SkillAssessment" p ON p."id"=NEW."assessmentId" AND p."revision">=NEW."revision" WHERE c."id"=NEW."receiptId" AND c."actorId"=NEW."evaluatorAccountId" AND c."commandKind"='RecordPracticeTrialAssessment' AND c."requestId"=NEW."requestId" AND c."resultRef"=NEW."reviewVersionId"::text AND a."ordinal"=1 AND a."eventType"='skill.assessment_issued.v1' AND a."aggregateId"=NEW."assessmentId"::text AND a."aggregateVersion"=NEW."revision" AND a."actorId"=NEW."evaluatorAccountId" AND a."correlationId"=NEW."requestId" AND a."guildId" IS NULL AND a."payload"=jsonb_build_object('skillAssessmentVersionId',NEW."id"::text) AND NOT EXISTS(SELECT 1 FROM "OutboxEvent" o WHERE o."eventId"=a."id")) THEN RAISE EXCEPTION 'Committed assessment requires exact finalized private review/audit/projection' USING ERRCODE='23000'; END IF;
	 RETURN NULL;
	END;
	$$;
	CREATE FUNCTION raid_assessment_decision_commit_v1() RETURNS trigger LANGUAGE plpgsql AS $$
	DECLARE prior "SkillAssessmentVersion"%ROWTYPE; r "PracticeAssessmentReviewVersion"%ROWTYPE; ownership_revision integer;
	BEGIN
	 SELECT * INTO prior FROM "SkillAssessmentVersion" WHERE "id"=NEW."priorAssessmentVersionId";
	 SELECT * INTO r FROM "PracticeAssessmentReviewVersion" WHERE "id"=NEW."caseReviewVersionId";
	 SELECT "revision" INTO ownership_revision FROM "PracticeTrialOwnershipVersion" WHERE "id"=NEW."ownershipVersionId";
	 IF NOT EXISTS(SELECT 1 FROM "SkillAssessmentVersion" v JOIN "SkillAssessment" p ON p."id"=v."assessmentId" AND p."revision">=v."revision" JOIN "CommandReceipt" c ON c."id"=NEW."receiptId" JOIN "AuditEvent" a ON a."receiptId"=c."id" WHERE v."id"=NEW."resultAssessmentVersionId" AND v."decisionId"=NEW."id" AND c."commandKind"='RecordPracticeAssessmentDecision' AND c."actorId"=NEW."evaluatorAccountId" AND c."requestId"=NEW."requestId" AND c."resultRef"=NEW."id"::text AND a."ordinal"=0 AND a."eventType"='skill.assessment_decision_recorded.v1' AND a."aggregateId"=NEW."assessmentId"::text AND a."aggregateVersion"=v."revision" AND a."actorId"=NEW."evaluatorAccountId" AND a."correlationId"=NEW."requestId" AND a."guildId" IS NULL AND a."payload"=jsonb_build_object('practiceAssessmentDecisionId',NEW."id"::text) AND NOT EXISTS(SELECT 1 FROM "OutboxEvent" o WHERE o."eventId"=a."id")) THEN RAISE EXCEPTION 'Decision requires atomic finalized private case receipt/audit/version/projection' USING ERRCODE='23000'; END IF;
