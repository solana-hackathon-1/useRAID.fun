	 CONSTRAINT "PracticeAssessmentDecision_ownership_fkey" FOREIGN KEY("ownershipVersionId") REFERENCES "PracticeTrialOwnershipVersion"("id") ON DELETE RESTRICT ON UPDATE RESTRICT,
