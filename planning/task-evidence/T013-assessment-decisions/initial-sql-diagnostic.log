	 CONSTRAINT "PracticeAssessmentDecision_policy_access_fkey" FOREIGN KEY("policyAccessReceiptId") REFERENCES "CommandReceipt"("id") ON DELETE RESTRICT ON UPDATE RESTRICT,
	 CONSTRAINT "PracticeAssessmentDecision_review_access_fkey" FOREIGN KEY("reviewAccessReceiptId") REFERENCES "CommandReceipt"("id") ON DELETE RESTRICT ON UPDATE RESTRICT,
	 CONSTRAINT "PracticeAssessmentDecision_ownership_access_fkey" FOREIGN KEY("ownershipAccessReceiptId") REFERENCES "CommandReceipt"("id") ON DELETE RESTRICT ON UPDATE RESTRICT,
	 CONSTRAINT "PracticeAssessmentDecision_prior_access_fkey" FOREIGN KEY("priorAccessReceiptId") REFERENCES "CommandReceipt"("id") ON DELETE RESTRICT ON UPDATE RESTRICT,
