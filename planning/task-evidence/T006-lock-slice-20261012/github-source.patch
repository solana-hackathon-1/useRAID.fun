@@ -0,0 +1,46 @@
+import { z } from 'zod';
+import { assetKey } from '../contracts/assets';
+import {
+  ProjectControlContextSchema,
+  ProjectControlFactsSchema,
+  type ProjectControlProofResult,
+  type ProjectControlReason,
+} from './control-attestation-contracts';
+import { SavedGuildProjectProposalSchema } from './project-proposal-contracts';
+
+// JavaScript timestamps preserve milliseconds; do not sign or compare silently truncated precision.
+const ProposalSnapshotSchema = SavedGuildProjectProposalSchema.refine((proposal) => {
+  const fraction = proposal.recordedAt.match(/\.(\d+)Z$/)?.[1];
+  return !fraction || fraction.length <= 3;
+});
+
+/** Trusted server context. Coexists with v1; old signatures never acquire a proposal binding. */
+export const ProjectProposalControlContextSchema = z
+  .strictObject({
+    version: z.literal('v2'),
+    purpose: z.literal('EXISTING_PROJECT_PROPOSAL_CONTROL'),
+    control: ProjectControlContextSchema,
+    proposal: ProposalSnapshotSchema,
+  })
+  .refine(
+    ({ control, proposal }) =>
+      control.guildDraftId === proposal.guildDraftId.toLowerCase() &&
+      control.draftRevision === proposal.draftRevision &&
+      assetKey(control.assetId) === assetKey(proposal.candidateToken),
+  )
+  .readonly();
+export const ProjectProposalControlFactsSchema = z.strictObject({
+  version: z.literal('v2'),
+  control: ProjectControlFactsSchema,
+  proposal: ProposalSnapshotSchema.nullable(),
+});
+export type ProjectProposalControlContext = z.infer<typeof ProjectProposalControlContextSchema>;
+export type ProjectProposalControlFacts = z.infer<typeof ProjectProposalControlFactsSchema>;
+export type ProjectProposalControlProofResult = Readonly<
+  Omit<ProjectControlProofResult, 'version' | 'reason'> & {
+    version: 'v2';
+    proposalId: string;
+    proposalRevision: number;
+    reason: ProjectControlReason | 'PROPOSAL_CHANGED';
+  }
+>;
diff --git a/src/guild-profiles/proposal-control.ts b/src/guild-profiles/proposal-control.ts
new file mode 100644
index 0000000..f937520
--- /dev/null
+++ b/src/guild-profiles/proposal-control.ts
@@ -0,0 +1,95 @@
+import type { z } from 'zod';
+import { createProjectControlMessage, evaluateProjectControlProof } from './control-attestation';
+import {
+  ProjectControlContractError,
+  ProjectControlSignatureVerifierSchema,
+  type ProjectControlVerificationInput,
+} from './control-attestation-contracts';
+import {
+  ProjectProposalControlContextSchema,
+  ProjectProposalControlFactsSchema,
+  type ProjectProposalControlContext,
+  type ProjectProposalControlProofResult,
+} from './proposal-control-contracts';
+import type { SavedGuildProjectProposal } from './project-proposal-contracts';
+export * from './proposal-control-contracts';
+
+function parseHost<T>(schema: z.ZodType<T>, value: unknown): T {
+  const parsed = schema.safeParse(value);
+  if (!parsed.success) throw new ProjectControlContractError('INVALID_HOST_CONTRACT');
+  return parsed.data;
+}
+function snapshot(p: SavedGuildProjectProposal) {
+  // Fixed field order and timestamp normalization preserve canonical bytes across hosts.
+  return {
+    version: p.version,
+    id: p.id.toLowerCase(),
+    guildDraftId: p.guildDraftId.toLowerCase(),
+    revision: p.revision,
+    draftRevision: p.draftRevision,
+    recordedAt: new Date(p.recordedAt).toISOString(),
+    projectType: p.projectType,
+    state: p.state,
+    persisted: p.persisted,
+    candidateToken: {
+      chain: p.candidateToken.chain,
+      networkIdentity: p.candidateToken.networkIdentity,
+      kind: p.candidateToken.kind,
+      mint: p.candidateToken.mint,
+      tokenProgram: p.candidateToken.tokenProgram,
+    },
+    publicEvidenceRefs: p.publicEvidenceRefs,
+    founderControlVerified: p.founderControlVerified,
+    recognizesGuild: p.recognizesGuild,
+    activatesToken: p.activatesToken,
+    createsPermissionGrant: p.createsPermissionGrant,
+    publicProfileApproved: p.publicProfileApproved,
+  };
+}
+function encode(context: ProjectProposalControlContext): string {
+  return (
+    'RAID existing-project proposal control attestation v2\n' +
+    JSON.stringify(
+      {
+        version: context.version,
+        purpose: context.purpose,
+        proposal: snapshot(context.proposal),
+        controlMessage: createProjectControlMessage(context.control),
+      },
+      null,
+      2,
+    )
+  );
+}
+export function createProjectProposalControlMessage(context: unknown): string {
+  return encode(parseHost(ProjectProposalControlContextSchema, context));
+}
+/** Informational only; actual current records and atomic nonce/recognition remain host obligations. */
+export function evaluateProjectProposalControlProof(
+  contextValue: unknown,
+  factsValue: unknown,
+  inputValue: unknown,
+  verifierValue: unknown,
+): ProjectProposalControlProofResult {
+  const context = parseHost(ProjectProposalControlContextSchema, contextValue);
+  const facts = parseHost(ProjectProposalControlFactsSchema, factsValue);
+  const verifier = parseHost(ProjectControlSignatureVerifierSchema, verifierValue);
+  const matches =
+    facts.proposal !== null &&
+    JSON.stringify(snapshot(facts.proposal)) === JSON.stringify(snapshot(context.proposal));
+  const result = evaluateProjectControlProof(context.control, facts.control, inputValue, {
+    version: 'v1',
+    algorithm: 'ED25519',
+    verify(input: ProjectControlVerificationInput) {
+      if (!matches) return false;
+      return verifier.verify(Object.freeze({ ...input, message: encode(context) }));
+    },
+  });
+  return Object.freeze({
+    ...result,
+    version: 'v2',
+    proposalId: context.proposal.id.toLowerCase(),
+    proposalRevision: context.proposal.revision,
+    reason: !matches && result.reason === 'SIGNATURE_INVALID' ? 'PROPOSAL_CHANGED' : result.reason,
+  });
+}
diff --git a/src/http-contracts/json.ts b/src/http-contracts/json.ts
new file mode 100644
index 0000000..28e7198
--- /dev/null
+++ b/src/http-contracts/json.ts
@@ -0,0 +1,49 @@
+const MAX_BYTES = 16384;
+export class JsonBodyFailure extends Error {
+  constructor(readonly status: number) {
+    super('INVALID_COMMAND');
+  }
+}
+export async function readBoundedJson(request: Request) {
+  if (
+    request.headers.get('content-type')?.split(';')[0].trim().toLowerCase() !== 'application/json'
+  )
+    throw new JsonBodyFailure(415);
+  const length = request.headers.get('content-length');
+  if (length !== null && (!/^\d+$/.test(length) || Number(length) > MAX_BYTES))
+    throw new JsonBodyFailure(Number(length) > MAX_BYTES ? 413 : 422);
+  if (!request.body) throw new JsonBodyFailure(422);
+  const reader = request.body.getReader();
+  let total = 0;
+  const parts: Uint8Array[] = [];
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<never>((_, reject) => {
+    timer = setTimeout(() => reject(new JsonBodyFailure(408)), 5000);
+  });
+  try {
+    while (true) {
+      const next = await Promise.race([reader.read(), timeout]);
+      if (next.done) break;
+      total += next.value.byteLength;
+      if (total > MAX_BYTES) throw new JsonBodyFailure(413);
+      parts.push(next.value);
+    }
+    const bytes = new Uint8Array(total);
+    let offset = 0;
+    for (const part of parts) {
+      bytes.set(part, offset);
+      offset += part.byteLength;
+    }
+    let raw: unknown;
+    try {
+      raw = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes));
+    } catch {
+      throw new JsonBodyFailure(422);
+    }
+    return raw;
+  } finally {
+    if (timer) clearTimeout(timer);
+    void reader.cancel().catch(() => {});
+    reader.releaseLock();
+  }
+}
