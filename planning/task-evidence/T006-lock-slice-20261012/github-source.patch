+import { z } from 'zod';
+import { SavedGuildDraftSchema } from './draft-storage-contracts';
+export const GuildDraftHttpStateSchema = z
+  .strictObject({
+    version: z.literal('v1'),
+    draft: SavedGuildDraftSchema,
+    writesAvailable: z.boolean(),
+    unavailableReason: z.literal('DISABLED').nullable(),
+  })
+  .refine((s) => s.writesAvailable === (s.unavailableReason === null));
+export const GuildDraftHttpSavedSchema = z.strictObject({
+  status: z.enum(['EXECUTED', 'REPLAYED']),
+  draft: SavedGuildDraftSchema,
+});
+export const GuildDraftFormStateSchema = z
+  .strictObject({
+    version: z.literal('v1'),
+    draft: SavedGuildDraftSchema.nullable(),
+    writesAvailable: z.boolean(),
+    unavailableReason: z.literal('DISABLED').nullable(),
+  })
+  .refine((s) => s.writesAvailable === (s.unavailableReason === null));
+export type GuildDraftFormState = z.infer<typeof GuildDraftFormStateSchema>;
diff --git a/src/guild-profiles/http-errors.ts b/src/guild-profiles/http-errors.ts
new file mode 100644
index 0000000..8b1f3ba
--- /dev/null
+++ b/src/guild-profiles/http-errors.ts
@@ -0,0 +1,69 @@
+import { InternalId } from '../contracts/ids';
+import { createErrorEnvelope, type ErrorCode } from '../contracts/protocol';
+import { CommandReceiptError } from '../command-receipts/contracts';
+import { JsonBodyFailure } from '../http-contracts/json';
+import { GuildDraftStorageError } from './draft-storage-contracts';
+export class GuildDraftHttpError extends Error {
+  constructor(readonly status: 401 | 403 | 429) {
+    super('HTTP_AUTHORITY_DENIED');
+    this.name = 'GuildDraftHttpError';
+  }
+}
+export const guildPreparationHeaders = Object.freeze({
+  'Cache-Control': 'private, no-store',
+  Vary: 'Cookie',
+});
+export function guildPreparationFailure(error: unknown, requestId: string) {
+  let code: ErrorCode = 'SERVICE_UNAVAILABLE',
+    status: number | undefined;
+  if (error instanceof JsonBodyFailure) {
+    code = 'INVALID_COMMAND';
+    status = error.status;
+  } else if (error instanceof GuildDraftHttpError) {
+    code =
+      error.status === 401
+        ? 'AUTHENTICATION_REQUIRED'
+        : error.status === 403
+          ? 'FORBIDDEN'
+          : 'RATE_LIMITED';
+  } else if (error instanceof GuildDraftStorageError) {
+    code =
+      error.code === 'UNAUTHENTICATED'
+        ? 'AUTHENTICATION_REQUIRED'
+        : error.code === 'ACCOUNT_RESTRICTED'
+          ? 'ACCOUNT_RESTRICTED'
+          : error.code === 'WRONG_ACTOR'
+            ? 'FORBIDDEN'
+            : error.code === 'NOT_FOUND'
+              ? 'NOT_FOUND'
+              : error.code === 'REVISION_CONFLICT'
+                ? 'REVISION_CHANGED'
+                : error.code === 'SLUG_UNAVAILABLE'
+                  ? 'DRAFT_SLUG_UNAVAILABLE'
+                  : ['INVALID_INPUT', 'SLUG_IMMUTABLE'].includes(error.code)
+                    ? 'INVALID_COMMAND'
+                    : 'SERVICE_UNAVAILABLE';
+  } else if (error instanceof CommandReceiptError) {
+    code =
+      error.code === 'IDEMPOTENCY_KEY_REUSED'
+        ? 'IDEMPOTENCY_KEY_REUSED'
+        : error.code === 'INVALID_INPUT'
+          ? 'INVALID_COMMAND'
+          : 'SERVICE_UNAVAILABLE';
+  }
+  const result = createErrorEnvelope(code, requestId);
+  return Response.json(result.body, {
+    status: status ?? result.status,
+    headers: guildPreparationHeaders,
+  });
+}
+
+export function guildPreparationRequestId(host: { requestId(): string }): string {
+  try {
+    const parsed = InternalId.safeParse(host.requestId());
+    if (parsed.success) return parsed.data;
+  } catch {
+    /* Safe fixed fallback, no private details. */
+  }
+  return crypto.randomUUID();
+}
diff --git a/src/guild-profiles/http.ts b/src/guild-profiles/http.ts
new file mode 100644
index 0000000..9d28df1
--- /dev/null
+++ b/src/guild-profiles/http.ts
@@ -0,0 +1,77 @@
+import { z } from 'zod';
+import { InternalId } from '../contracts/ids';
+import { readBoundedJson, JsonBodyFailure } from '../http-contracts/json';
+import {
+  SaveGuildDraftInputSchema,
+  GuildDraftStorageError,
+  type GuildDraftActor,
+  type GuildDraftCommand,
+} from './draft-storage-contracts';
+export { GuildDraftHttpStateSchema, GuildDraftHttpSavedSchema } from './http-contracts';
+import { GuildDraftHttpStateSchema, GuildDraftHttpSavedSchema } from './http-contracts';
+export interface GuildDraftHttpHost {
+  version: 'v1';
+  actor(): Promise<GuildDraftActor>;
+  checkOrigin(request: Request): Promise<void> | void;
+  rateLimit(actor: GuildDraftActor): Promise<void>;
+  read(actor: GuildDraftActor, id: string): Promise<unknown>;
+  save(command: GuildDraftCommand): Promise<unknown>;
+  requestId(): string;
+}
+export { GuildDraftHttpError } from './http-errors';
+import {
+  guildPreparationHeaders as headers,
+  guildPreparationFailure as failure,
+  guildPreparationRequestId,
+} from './http-errors';
+/** Portable Request/Response adapter. Host authority is rebuilt from trusted current state. */
+export function createGuildDraftHandlers(host: GuildDraftHttpHost) {
+  if (host.version !== 'v1') throw new GuildDraftStorageError('STORAGE_CONTRACT');
+  const requestId = () => guildPreparationRequestId(host);
+  return {
+    async POST(request: Request) {
+      const id = requestId();
+      try {
+        await host.checkOrigin(request);
+        const actor = await host.actor();
+        await host.rateLimit(actor);
+        const key = InternalId.safeParse(request.headers.get('idempotency-key'));
+        if (!key.success) throw new JsonBodyFailure(422);
+        const input = SaveGuildDraftInputSchema.safeParse(await readBoundedJson(request));
+        if (!input.success) throw new JsonBodyFailure(422);
+        const value = GuildDraftHttpSavedSchema.safeParse(
+          await host.save({ actor, input: input.data, idempotencyKey: key.data, requestId: id }),
+        );
+        if (!value.success) throw new GuildDraftStorageError('STORAGE_CONTRACT');
+        const snapshot = value.data.draft;
+        if (
+          snapshot.revision !== input.data.expectedRevision + 1 ||
+          (input.data.guildDraftId !== null &&
+            snapshot.id.toLowerCase() !== input.data.guildDraftId.toLowerCase()) ||
+          snapshot.profile.name !== input.data.profile.name ||
+          snapshot.profile.slug !== input.data.profile.slug ||
+          snapshot.profile.description !== input.data.profile.description
+        )
+          throw new GuildDraftStorageError('STORAGE_CONTRACT');
+        return Response.json(value.data, { headers });
+      } catch (error) {
+        return failure(error, id);
+      }
+    },
+    async GET(_request: Request, draftId: string | Promise<string>) {
+      const id = requestId();
+      try {
+        const actor = await host.actor();
+        const parsed = z.uuid().safeParse(await draftId);
+        if (!parsed.success) throw new JsonBodyFailure(422);
+        const value = GuildDraftHttpStateSchema.safeParse(await host.read(actor, parsed.data));
+        if (!value.success) throw new GuildDraftStorageError('STORAGE_CONTRACT');
+        if (value.data.draft.id.toLowerCase() !== parsed.data.toLowerCase())
+          throw new GuildDraftStorageError('STORAGE_CONTRACT');
+        return Response.json(value.data, { headers });
+      } catch (error) {
+        return failure(error, id);
+      }
+    },
+  };
+}
diff --git a/src/guild-profiles/index.ts b/src/guild-profiles/index.ts
new file mode 100644
index 0000000..9086dfc
--- /dev/null
+++ b/src/guild-profiles/index.ts
@@ -0,0 +1,88 @@
+import {
+  GuildProfileContractError,
+  GuildProfileDraftInputSchema,
+  GuildPublicProjectionSourceSchema,
+  GuildProfilePermissionFactsSchema,
+  GuildProfilePermissionRequestSchema,
+  GuildProfileFieldSchema,
+  type GuildProfileDecisionReason,
+} from './contracts';
+export * from './contracts';
+/** Preparation only: no id/store, founder verification, token relationship or permission side effect. */
+export function prepareGuildProfileDraft(input: unknown) {
+  const parsed = GuildProfileDraftInputSchema.safeParse(input);
+  if (!parsed.success) throw new GuildProfileContractError('INVALID_INPUT');
+  return Object.freeze({
+    version: 'v1' as const,
+    state: 'DRAFT_PROPOSAL' as const,
+    persisted: false as const,
+    founderControlVerified: false as const,
+    createsPermissionGrant: false as const,
+    profile: Object.freeze({ ...parsed.data, primaryToken: null }),
+  });
+}
+/** Host supplies approved public fields from its authoritative record; private data is never copied. */
+export function projectPublicGuildProfile(record: unknown) {
+  const parsed = GuildPublicProjectionSourceSchema.safeParse(record);
+  if (!parsed.success) throw new GuildProfileContractError('INVALID_HOST_CONTRACT');
+  const { guild, publicProfile, publicProfileApproved } = parsed.data;
+  if (!publicProfileApproved) throw new GuildProfileContractError('PUBLIC_PROFILE_UNAVAILABLE');
+  if (
+    guild.id !== publicProfile.id ||
+    JSON.stringify(guild.primaryToken) !== JSON.stringify(publicProfile.primaryToken)
+  )
+    throw new GuildProfileContractError('INVALID_HOST_CONTRACT');
+  return Object.freeze({
+    id: publicProfile.id,
+    slug: publicProfile.slug,
+    name: publicProfile.name,
+    description: publicProfile.description,
+    primaryToken:
+      publicProfile.primaryToken === null ? null : Object.freeze({ ...publicProfile.primaryToken }),
+  });
+}
+/** Informational policy only. The command host must authenticate and rebuild facts under its locks. */
+export function evaluateGuildProfilePermission(facts: unknown, request: unknown) {
+  const parsed = GuildProfilePermissionFactsSchema.safeParse(facts);
+  if (!parsed.success) throw new GuildProfileContractError('INVALID_HOST_CONTRACT');
+  const command = GuildProfilePermissionRequestSchema.safeParse(request);
+  if (!command.success) throw new GuildProfileContractError('INVALID_INPUT');
+  const data = parsed.data;
+  const target = command.data;
+  const decision = (reason: GuildProfileDecisionReason) =>
+    Object.freeze({
+      version: 'v1' as const,
+      allowed: reason === 'ALLOWED',
+      reason,
+      informational: true as const,
+      isAuthorizationToken: false as const,
+      persists: false as const,
+    });
+  if (!data.actorSessionAuthorized || data.actorAccountId === null)
+    return decision('AUTHENTICATION_REQUIRED');
+  if (data.actorRestricted) return decision('ACCOUNT_RESTRICTED');
+  if (data.guild.id !== target.guildId) return decision('WRONG_GUILD');
+  if (data.guild.revision !== target.expectedRevision) return decision('REVISION_CHANGED');
+  if (!['EDIT_PROFILE', 'DELEGATE_PROFILE'].includes(target.action))
+    return decision('UNSUPPORTED_ACTION');
+  if (target.fields.some((field) => !GuildProfileFieldSchema.safeParse(field).success))
+    return decision('UNSUPPORTED_FIELD');
+  if (!data.founderControlVerified) return decision('FOUNDER_VERIFICATION_REQUIRED');
+  if (data.actorAccountId === data.guild.founderAccountId) return decision('ALLOWED');
+  const live = data.grants.filter(
+    (grant) =>
+      grant.guildId === target.guildId &&
+      grant.granteeAccountId === data.actorAccountId &&
+      grant.status === 'ACTIVE' &&
+      Date.parse(grant.validFrom) <= Date.parse(data.now) &&
+      (grant.expiresAt === null || Date.parse(grant.expiresAt) > Date.parse(data.now)) &&
+      (target.action !== 'DELEGATE_PROFILE' || grant.canDelegateProfile),
+  );
+  return decision(
+    target.fields.every((field) =>
+      live.some((grant) => grant.fields.includes(field as 'name' | 'description')),
+    )
+      ? 'ALLOWED'
+      : 'PERMISSION_NOT_GRANTED',
+  );
+}
