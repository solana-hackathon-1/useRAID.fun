--- /dev/null
+++ b/src/guild-profiles/ed25519-control-verifier.ts
@@ -0,0 +1,24 @@
+import nacl from 'tweetnacl';
+import bs58 from 'bs58';
+import type {
+  ProjectControlSignatureVerifier,
+  ProjectControlVerificationInput,
+} from './control-attestation-contracts';
+/** Local crypto adapter. Domain module never owns a signing key or calls a wallet/provider. */
+export const ed25519ProjectControlVerifier: ProjectControlSignatureVerifier = Object.freeze({
+  version: 'v1',
+  algorithm: 'ED25519',
+  verify({ message, signature, signer }: ProjectControlVerificationInput) {
+    try {
+      const publicKey = bs58.decode(signer);
+      const bytes = bs58.decode(signature);
+      return (
+        publicKey.length === 32 &&
+        bytes.length === 64 &&
+        nacl.sign.detached.verify(new TextEncoder().encode(message), bytes, publicKey)
+      );
+    } catch {
+      return false;
+    }
+  },
+});
diff --git a/src/guild-profiles/holder-observation-contracts.ts b/src/guild-profiles/holder-observation-contracts.ts
new file mode 100644
index 0000000..5d9d405
--- /dev/null
+++ b/src/guild-profiles/holder-observation-contracts.ts
@@ -0,0 +1,132 @@
+import { z } from 'zod';
+import { AmountSchema, SolanaAddress, TokenAssetIdSchema } from '../contracts/assets';
+import { AccountId, InternalId, Revision, UtcTimestamp } from '../contracts/ids';
+import { GuildSchema } from '../contracts/entities';
+const Timestamp = UtcTimestamp.refine((value) => {
+  const fraction = value.match(/\.(\d+)Z$/)?.[1];
+  return !fraction || fraction.length <= 3;
+});
+const Reference = z.strictObject({ recordId: InternalId, revision: Revision }).readonly();
+const RawUnits = AmountSchema.max(78);
+const Provider = z.strictObject({ id: InternalId, adapterVersion: InternalId }).readonly();
+const Wallets = z.array(SolanaAddress).max(1000);
+/** Current authenticated self, actual recognized asset and approved policy; never HTTP caller input. */
+export const GuildHolderContextSchema = z.strictObject({
+  version: z.literal('v1'),
+  now: Timestamp,
+  guild: GuildSchema,
+  relationship: z.strictObject({
+    reference: Reference,
+    status: z.enum(['VERIFIED', 'PENDING', 'REVOKED', 'CONFLICT']),
+  }),
+  actorAccountId: AccountId.nullable(),
+  actorSessionAuthorized: z.boolean(),
+  actorRestricted: z.boolean(),
+  accountId: AccountId,
+  wallets: Wallets.refine((values) => new Set(values).size === values.length),
+  policy: z.strictObject({
+    reference: Reference,
+    status: z.enum(['APPROVED', 'UNAPPROVED', 'REVOKED']),
+    ownershipScope: z.enum(['CURRENT_VERIFIED_LINKED_WALLETS', 'UNSUPPORTED']),
+    minimumBalanceBaseUnits: RawUnits.refine((value) => BigInt(value) > 0n),
+    minimumFinality: z.enum(['CONFIRMED', 'FINALIZED']),
+    maxObservationAgeMs: z.number().int().min(1).max(Number.MAX_SAFE_INTEGER),
+  }),
+});
+export const GuildHolderObservationSchema = z.discriminatedUnion('status', [
+  z.strictObject({
+    version: z.literal('v1'),
+    status: z.literal('VERIFIED'),
+    relationshipReference: Reference,
+    policyReference: Reference,
+    assetId: TokenAssetIdSchema,
+    queriedWallets: Wallets,
+    complete: z.boolean(),
+    observedAt: Timestamp,
+    observedSlot: RawUnits,
+    finality: z.enum(['PROCESSED', 'CONFIRMED', 'FINALIZED']),
+    provider: Provider,
+    accounts: z
+      .array(
+        z.strictObject({
+          address: SolanaAddress,
+          owner: SolanaAddress,
+          assetId: TokenAssetIdSchema,
+          balanceBaseUnits: RawUnits,
+        }),
+      )
+      .max(10000),
+  }),
+  z.strictObject({
+    version: z.literal('v1'),
+    status: z.literal('UNAVAILABLE'),
+    provider: Provider,
+  }),
+  z.strictObject({ version: z.literal('v1'), status: z.literal('CONFLICT'), provider: Provider }),
+]);
+export type GuildHolderContext = z.infer<typeof GuildHolderContextSchema>;
+export type GuildHolderObservation = z.infer<typeof GuildHolderObservationSchema>;
+export type GuildHolderObservationRequest = Readonly<{
+  version: 'v1';
+  guildId: string;
+  relationshipReference: Readonly<{ recordId: string; revision: number }>;
+  policyReference: Readonly<{ recordId: string; revision: number }>;
+  assetId: z.infer<typeof TokenAssetIdSchema>;
+  wallets: readonly string[];
+}>;
+/** Explicit complete-scope read port. Real host owns timeout, trusted network/config and post-read rechecks. */
+export interface GuildHolderObservationAdapter {
+  readonly version: 'v1';
+  observe(request: GuildHolderObservationRequest): Promise<GuildHolderObservation>;
+}
+export type GuildHolderReason =
+  | 'VERIFIED_BALANCE'
+  | 'RELATIONSHIP_UNAVAILABLE'
+  | 'POLICY_UNAVAILABLE'
+  | 'OWNERSHIP_SCOPE_UNSUPPORTED'
+  | 'OWNERSHIP_UNAVAILABLE'
+  | 'PROVIDER_UNAVAILABLE'
+  | 'SOURCE_CONFLICT'
+  | 'RELATIONSHIP_CHANGED'
+  | 'POLICY_CHANGED'
+  | 'ASSET_MISMATCH'
+  | 'OWNERSHIP_SCOPE_MISMATCH'
+  | 'INCOMPLETE_OBSERVATION'
+  | 'OBSERVATION_NOT_YET_VALID'
+  | 'OBSERVATION_STALE'
+  | 'FINALITY_PENDING';
+export type GuildHolderEligibility = Readonly<{
+  version: 'v1';
+  guildId: string;
+  targetAssetId: z.infer<typeof TokenAssetIdSchema> | null;
+  relationshipReference: Readonly<{ recordId: string; revision: number }>;
+  policyReference: Readonly<{ recordId: string; revision: number }>;
+  computedAt: string;
+  state: 'ELIGIBLE' | 'NOT_ELIGIBLE' | 'UNKNOWN' | 'STALE';
+  holderEligible: boolean | null;
+  reason: GuildHolderReason;
+  balanceBaseUnits: string | null;
+  observedAt: string | null;
+  observedSlot: string | null;
+  finality: 'PROCESSED' | 'CONFIRMED' | 'FINALIZED' | null;
+  provider: Readonly<{ id: string; adapterVersion: string }> | null;
+  informational: true;
+  isAuthorizationToken: false;
+  persisted: false;
+  createsPermissionGrant: false;
+  verifiesFounderControl: false;
+  enrollsPublicAssociation: false;
+  subscribesNotifications: false;
+  consumesCapacity: false;
+  affectsWorkHistory: false;
+  affectsClaims: false;
+}>;
+export class GuildHolderContractError extends Error {
+  constructor(
+    readonly code:
+      'INVALID_HOST_CONTRACT' | 'AUTHENTICATION_REQUIRED' | 'ACCOUNT_RESTRICTED' | 'FORBIDDEN',
+  ) {
+    super(code);
+    this.name = 'GuildHolderContractError';
+  }
+}
diff --git a/src/guild-profiles/holder-observation.ts b/src/guild-profiles/holder-observation.ts
new file mode 100644
index 0000000..97c6a56
--- /dev/null
+++ b/src/guild-profiles/holder-observation.ts
@@ -0,0 +1,116 @@
+import { assetKey } from '../contracts/assets';
+import {
+  GuildHolderContextSchema,
+  GuildHolderObservationSchema,
+  GuildHolderContractError,
+  type GuildHolderEligibility,
+  type GuildHolderReason,
+} from './holder-observation-contracts';
+export * from './holder-observation-contracts';
+/** Private informational calculation; current recognized authority and real chain observations are host-owned. */
+export function evaluateGuildHolderEligibility(
+  contextValue: unknown,
+  observationValue: unknown,
+): GuildHolderEligibility {
+  const parsed = GuildHolderContextSchema.safeParse(contextValue);
+  if (!parsed.success) throw new GuildHolderContractError('INVALID_HOST_CONTRACT');
+  const c = parsed.data;
+  if (!c.actorAccountId || !c.actorSessionAuthorized)
+    throw new GuildHolderContractError('AUTHENTICATION_REQUIRED');
+  if (c.actorRestricted) throw new GuildHolderContractError('ACCOUNT_RESTRICTED');
+  if (c.actorAccountId !== c.accountId) throw new GuildHolderContractError('FORBIDDEN');
+  const parsedObservation =
+    observationValue === null ? null : GuildHolderObservationSchema.safeParse(observationValue);
+  if (parsedObservation && !parsedObservation.success)
+    throw new GuildHolderContractError('INVALID_HOST_CONTRACT');
+  const o = parsedObservation?.success ? parsedObservation.data : null;
+  const result = (
+    reason: GuildHolderReason,
+    balance: bigint | null = null,
+  ): GuildHolderEligibility => {
+    const known = balance !== null;
+    const eligible = known ? balance >= BigInt(c.policy.minimumBalanceBaseUnits) : null;
+    const metadata =
+      o?.status === 'VERIFIED' &&
+      (known ||
+        reason === 'OBSERVATION_STALE' ||
+        reason === 'OBSERVATION_NOT_YET_VALID' ||
+        reason === 'FINALITY_PENDING')
+        ? o
+        : null;
+    return Object.freeze({
+      version: 'v1',
+      guildId: c.guild.id,
+      targetAssetId: c.guild.primaryToken,
+      relationshipReference: c.relationship.reference,
+      policyReference: c.policy.reference,
+      computedAt: new Date(c.now).toISOString(),
+      state: known
+        ? eligible
+          ? 'ELIGIBLE'
+          : 'NOT_ELIGIBLE'
+        : reason === 'OBSERVATION_STALE'
+          ? 'STALE'
+          : 'UNKNOWN',
+      holderEligible: eligible,
+      reason,
+      balanceBaseUnits: balance?.toString() ?? null,
+      observedAt: metadata ? new Date(metadata.observedAt).toISOString() : null,
+      observedSlot: metadata?.observedSlot ?? null,
+      finality: metadata?.finality ?? null,
+      provider: o?.provider ?? null,
+      informational: true,
+      isAuthorizationToken: false,
+      persisted: false,
+      createsPermissionGrant: false,
+      verifiesFounderControl: false,
+      enrollsPublicAssociation: false,
+      subscribesNotifications: false,
+      consumesCapacity: false,
+      affectsWorkHistory: false,
+      affectsClaims: false,
+    });
+  };
+  if (c.relationship.status !== 'VERIFIED' || !c.guild.primaryToken)
+    return result('RELATIONSHIP_UNAVAILABLE');
+  if (c.policy.status !== 'APPROVED') return result('POLICY_UNAVAILABLE');
+  if (c.policy.ownershipScope !== 'CURRENT_VERIFIED_LINKED_WALLETS')
+    return result('OWNERSHIP_SCOPE_UNSUPPORTED');
+  if (!c.wallets.length) return result('OWNERSHIP_UNAVAILABLE');
+  if (!o || o.status === 'UNAVAILABLE') return result('PROVIDER_UNAVAILABLE');
+  if (o.status === 'CONFLICT') return result('SOURCE_CONFLICT');
+  const sameReference = (a: typeof c.relationship.reference, b: typeof a) =>
+    a.recordId === b.recordId && a.revision === b.revision;
+  if (!sameReference(c.relationship.reference, o.relationshipReference))
+    return result('RELATIONSHIP_CHANGED');
+  if (!sameReference(c.policy.reference, o.policyReference)) return result('POLICY_CHANGED');
+  const asset = assetKey(c.guild.primaryToken);
+  if (assetKey(o.assetId) !== asset) return result('ASSET_MISMATCH');
+  if (
+    new Set(o.queriedWallets).size !== o.queriedWallets.length ||
+    o.queriedWallets.length !== c.wallets.length ||
+    o.queriedWallets.some((wallet) => !c.wallets.includes(wallet))
+  )
+    return result('OWNERSHIP_SCOPE_MISMATCH');
+  if (!o.complete) return result('INCOMPLETE_OBSERVATION');
+  const age = Date.parse(c.now) - Date.parse(o.observedAt);
+  if (age < 0) return result('OBSERVATION_NOT_YET_VALID');
+  if (age >= c.policy.maxObservationAgeMs) return result('OBSERVATION_STALE');
+  const finality = { PROCESSED: 0, CONFIRMED: 1, FINALIZED: 2 };
+  if (finality[o.finality] < finality[c.policy.minimumFinality]) return result('FINALITY_PENDING');
+  const accounts = new Map<string, { owner: string; balance: string }>();
+  let balance = 0n;
+  for (const row of o.accounts) {
+    if (assetKey(row.assetId) !== asset) return result('ASSET_MISMATCH');
+    if (!c.wallets.includes(row.owner)) return result('OWNERSHIP_SCOPE_MISMATCH');
+    const previous = accounts.get(row.address);
+    if (previous) {
+      if (previous.owner !== row.owner || previous.balance !== row.balanceBaseUnits)
+        return result('SOURCE_CONFLICT');
+      continue;
+    }
+    accounts.set(row.address, { owner: row.owner, balance: row.balanceBaseUnits });
+    balance += BigInt(row.balanceBaseUnits);
+  }
+  return result('VERIFIED_BALANCE', balance);
+}
