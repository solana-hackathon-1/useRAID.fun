+import { z } from 'zod';
+import { PublicGuildSchema, GuildSchema } from '../contracts/entities';
+import { AccountId, GuildId, InternalId, Revision, UtcTimestamp } from '../contracts/ids';
+const MillisecondUtcTimestamp = UtcTimestamp.refine((value) => {
+  const fraction = value.match(/\.(\d+)Z$/)?.[1];
+  return !fraction || fraction.length <= 3;
+});
+export const GuildProfileFieldSchema = z.enum(['name', 'description']);
+export const GuildProfileDraftInputSchema = PublicGuildSchema.pick({
+  name: true,
+  slug: true,
+  description: true,
+})
+  .extend({
+    name: z.string().trim().pipe(PublicGuildSchema.shape.name),
+    slug: z.string().trim().pipe(PublicGuildSchema.shape.slug),
+    description: z.string().trim().pipe(PublicGuildSchema.shape.description),
+  })
+  .strict();
+export const GuildPublicProjectionSourceSchema = z
+  .object({
+    version: z.literal('v1'),
+    guild: GuildSchema,
+    publicProfile: PublicGuildSchema,
+    publicProfileApproved: z.boolean(),
+    privateContext: z.unknown().optional(),
+  })
+  .strict();
+export const GuildProfileGrantSchema = z
+  .object({
+    id: InternalId,
+    guildId: GuildId,
+    granteeAccountId: AccountId,
+    status: z.enum(['ACTIVE', 'REVOKED']),
+    fields: z
+      .array(GuildProfileFieldSchema)
+      .min(1)
+      .max(2)
+      .refine((a) => new Set(a).size === a.length),
+    canDelegateProfile: z.boolean(),
+    validFrom: MillisecondUtcTimestamp,
+    expiresAt: MillisecondUtcTimestamp.nullable(),
+  })
+  .strict()
+  .refine((g) => g.expiresAt === null || Date.parse(g.expiresAt) > Date.parse(g.validFrom));
+/** Trusted host facts, not HTTP input. No global role/token balance creates these grants. */
+export const GuildProfilePermissionFactsSchema = z
+  .object({
+    version: z.literal('v1'),
+    guild: GuildSchema,
+    founderControlVerified: z.boolean(),
+    actorAccountId: AccountId.nullable(),
+    actorSessionAuthorized: z.boolean(),
+    actorRestricted: z.boolean(),
+    holderEligible: z.boolean().nullable(),
+    now: MillisecondUtcTimestamp,
+    grants: z
+      .array(GuildProfileGrantSchema)
+      .max(1000)
+      .refine((grants) => new Set(grants.map((grant) => grant.id)).size === grants.length),
+  })
+  .strict();
+export const GuildProfilePermissionRequestSchema = z
+  .object({
+    guildId: GuildId,
+    expectedRevision: Revision,
+    action: z.string().min(1).max(64),
+    fields: z.array(z.string().min(1).max(80)).min(1).max(20),
+  })
+  .strict();
+export type GuildProfilePermissionFacts = z.infer<typeof GuildProfilePermissionFactsSchema>;
+export type GuildProfilePermissionRequest = z.infer<typeof GuildProfilePermissionRequestSchema>;
+export type GuildProfileDecisionReason =
+  | 'ALLOWED'
+  | 'AUTHENTICATION_REQUIRED'
+  | 'ACCOUNT_RESTRICTED'
+  | 'WRONG_GUILD'
+  | 'REVISION_CHANGED'
+  | 'UNSUPPORTED_ACTION'
+  | 'UNSUPPORTED_FIELD'
+  | 'FOUNDER_VERIFICATION_REQUIRED'
+  | 'PERMISSION_NOT_GRANTED';
+export class GuildProfileContractError extends Error {
+  constructor(
+    readonly code: 'INVALID_INPUT' | 'INVALID_HOST_CONTRACT' | 'PUBLIC_PROFILE_UNAVAILABLE',
+  ) {
+    super(code);
+    this.name = 'GuildProfileContractError';
+  }
+}
diff --git a/src/guild-profiles/control-attestation-contracts.ts b/src/guild-profiles/control-attestation-contracts.ts
new file mode 100644
index 0000000..dc7c0a1
--- /dev/null
+++ b/src/guild-profiles/control-attestation-contracts.ts
@@ -0,0 +1,160 @@
+import { z } from 'zod';
+import bs58 from 'bs58';
+import { TokenAssetIdSchema, SolanaAddress } from '../contracts/assets';
+import { AccountId, InternalId, Revision, UtcTimestamp } from '../contracts/ids';
+
+const Timestamp = UtcTimestamp.refine((value) => {
+  const fraction = value.match(/\.(\d+)Z$/)?.[1];
+  return !fraction || fraction.length <= 3;
+});
+const DraftId = z.uuid().transform((value) => value.toLowerCase());
+const Origin = z
+  .string()
+  .max(2000)
+  .refine((value) => {
+    try {
+      const url = new URL(value);
+      const local = ['localhost', '127.0.0.1', '[::1]'].includes(url.hostname);
+      return (
+        url.origin === value &&
+        !url.username &&
+        !url.password &&
+        (url.protocol === 'https:' || (local && url.protocol === 'http:'))
+      );
+    } catch {
+      return false;
+    }
+  });
+export const ProjectControlReferenceSchema = z
+  .strictObject({ recordId: InternalId, revision: Revision })
+  .readonly();
+/** Server-owned context. Approval/reference IDs are never accepted from HTTP callers. */
+export const ProjectControlContextSchema = z
+  .strictObject({
+    version: z.literal('v1'),
+    purpose: z.literal('EXISTING_PROJECT_CONTROL'),
+    challengeId: InternalId,
+    origin: Origin,
+    actorAccountId: AccountId,
+    guildDraftId: DraftId,
+    draftRevision: Revision,
+    assetId: TokenAssetIdSchema,
+    signer: SolanaAddress,
+    nonce: z.string().regex(/^[a-f0-9]{64}$/),
+    issuedAt: Timestamp,
+    expiresAt: Timestamp,
+    policy: ProjectControlReferenceSchema,
+    authority: ProjectControlReferenceSchema,
+    publicEvidence: ProjectControlReferenceSchema,
+  })
+  .refine((c) => Date.parse(c.expiresAt) > Date.parse(c.issuedAt))
+  .readonly();
+const observation = { observedAt: Timestamp, validUntil: Timestamp };
+/** Snapshot from authenticated storage/approved policy and authoritative observations, not client facts. */
+export const ProjectControlFactsSchema = z.strictObject({
+  version: z.literal('v1'),
+  now: Timestamp,
+  origin: Origin,
+  actor: z.strictObject({
+    accountId: AccountId.nullable(),
+    sessionAuthorized: z.boolean(),
+    restricted: z.boolean(),
+  }),
+  draft: z.strictObject({ id: DraftId, ownerAccountId: AccountId, revision: Revision }),
+  challengeState: z.enum(['AVAILABLE', 'CONSUMED', 'REVOKED']),
+  policy: z.strictObject({
+    reference: ProjectControlReferenceSchema,
+    status: z.enum(['APPROVED', 'UNAPPROVED', 'REVOKED']),
+    purpose: z.literal('EXISTING_PROJECT_CONTROL'),
+    route: z.literal('PROJECT_WALLET_SIGNATURE'),
+  }),
+  authority: z
+    .strictObject({
+      reference: ProjectControlReferenceSchema,
+      policyReference: ProjectControlReferenceSchema,
+      assetId: TokenAssetIdSchema,
+      signer: SolanaAddress,
+      status: z.enum(['CURRENT', 'STALE', 'UNKNOWN', 'REVOKED', 'CONFLICT']),
+      ...observation,
+    })
+    .refine((o) => Date.parse(o.validUntil) > Date.parse(o.observedAt)),
+  publicEvidence: z
+    .strictObject({
+      reference: ProjectControlReferenceSchema,
+      policyReference: ProjectControlReferenceSchema,
+      authorityReference: ProjectControlReferenceSchema,
+      assetId: TokenAssetIdSchema,
+      status: z.enum(['VERIFIED', 'UNVERIFIED', 'STALE', 'UNKNOWN', 'REVOKED']),
+      ...observation,
+    })
+    .refine((o) => Date.parse(o.validUntil) > Date.parse(o.observedAt)),
+});
+export const ProjectControlProofInputSchema = z.strictObject({
+  signature: z
+    .string()
+    .min(1)
+    .max(88)
+    .refine((value) => {
+      try {
+        return bs58.decode(value).length === 64;
+      } catch {
+        return false;
+      }
+    }),
+});
+export type ProjectControlContext = z.infer<typeof ProjectControlContextSchema>;
+export type ProjectControlFacts = z.infer<typeof ProjectControlFactsSchema>;
+export type ProjectControlProofInput = z.infer<typeof ProjectControlProofInputSchema>;
+export type ProjectControlVerificationInput = Readonly<{
+  message: string;
+  signature: string;
+  signer: string;
+}>;
+/** Synchronous local verification only; no network, retries, secret keys or side effects. */
+export interface ProjectControlSignatureVerifier {
+  readonly version: 'v1';
+  readonly algorithm: 'ED25519';
+  verify(input: ProjectControlVerificationInput): boolean;
+}
+/** Shared structural port check; implementations must also return an actual synchronous boolean. */
+export const ProjectControlSignatureVerifierSchema = z.strictObject({
+  version: z.literal('v1'),
+  algorithm: z.literal('ED25519'),
+  verify: z.custom<(input: ProjectControlVerificationInput) => unknown>(
+    (value) => typeof value === 'function',
+  ),
+});
+export type ProjectControlReason =
+  | 'SIGNATURE_BOUND'
+  | 'AUTHENTICATION_REQUIRED'
+  | 'ACCOUNT_RESTRICTED'
+  | 'RESOURCE_UNAVAILABLE'
+  | 'REVISION_CHANGED'
+  | 'ORIGIN_MISMATCH'
+  | 'CHALLENGE_UNAVAILABLE'
+  | 'CHALLENGE_EXPIRED'
+  | 'CHALLENGE_NOT_YET_VALID'
+  | 'POLICY_UNAVAILABLE'
+  | 'AUTHORITY_UNAVAILABLE'
+  | 'PUBLIC_EVIDENCE_UNAVAILABLE'
+  | 'SIGNATURE_INVALID';
+export type ProjectControlProofResult = Readonly<{
+  version: 'v1';
+  challengeId: string;
+  state: 'SIGNATURE_BOUND' | 'REJECTED';
+  reason: ProjectControlReason;
+  informational: true;
+  isAuthorizationToken: false;
+  persisted: false;
+  founderControlVerified: false;
+  recognizesGuild: false;
+  activatesToken: false;
+  createsPermissionGrant: false;
+  consumesNonce: false;
+}>;
+export class ProjectControlContractError extends Error {
+  constructor(readonly code: 'INVALID_INPUT' | 'INVALID_HOST_CONTRACT' | 'VERIFIER_UNAVAILABLE') {
+    super(code);
+    this.name = 'ProjectControlContractError';
+  }
+}
diff --git a/src/guild-profiles/control-attestation.ts b/src/guild-profiles/control-attestation.ts
new file mode 100644
index 0000000..1384c14
--- /dev/null
+++ b/src/guild-profiles/control-attestation.ts
@@ -0,0 +1,140 @@
+import { z } from 'zod';
+import { assetKey } from '../contracts/assets';
+import {
+  ProjectControlContextSchema,
+  ProjectControlFactsSchema,
+  ProjectControlProofInputSchema,
+  ProjectControlContractError,
+  ProjectControlSignatureVerifierSchema,
+  type ProjectControlContext,
+  type ProjectControlProofResult,
+  type ProjectControlReason,
+} from './control-attestation-contracts';
+export * from './control-attestation-contracts';
+
+function parseHost<T>(schema: z.ZodType<T>, value: unknown): T {
+  const parsed = schema.safeParse(value);
+  if (!parsed.success) throw new ProjectControlContractError('INVALID_HOST_CONTRACT');
+  return parsed.data;
+}
+const reference = (r: ProjectControlContext['policy']) => ({
+  recordId: r.recordId,
+  revision: r.revision,
+});
+const sameReference = (a: ProjectControlContext['policy'], b: ProjectControlContext['policy']) =>
+  a.recordId === b.recordId && a.revision === b.revision;
+function encode(context: ProjectControlContext): string {
+  // Explicit field order; caller object insertion order cannot alter the signed bytes.
+  return (
+    'RAID existing-project control attestation v1\n' +
+    JSON.stringify(
+      {
+        version: context.version,
+        purpose: context.purpose,
+        challengeId: context.challengeId,
+        origin: context.origin,
+        actorAccountId: context.actorAccountId,
+        guildDraftId: context.guildDraftId,
+        draftRevision: context.draftRevision,
+        assetId: {
+          chain: context.assetId.chain,
+          networkIdentity: context.assetId.networkIdentity,
+          kind: context.assetId.kind,
+          mint: context.assetId.mint,
+          tokenProgram: context.assetId.tokenProgram,
+        },
+        signer: context.signer,
+        nonce: context.nonce,
+        issuedAt: new Date(context.issuedAt).toISOString(),
+        expiresAt: new Date(context.expiresAt).toISOString(),
+        policy: reference(context.policy),
+        authority: reference(context.authority),
+        publicEvidence: reference(context.publicEvidence),
+      },
+      null,
+      2,
+    )
+  );
+}
+export function createProjectControlMessage(context: unknown): string {
+  return encode(parseHost(ProjectControlContextSchema, context));
+}
+/** Informational only. Host must independently reauthorize/atomically consume proof before recognition. */
+export function evaluateProjectControlProof(
+  contextValue: unknown,
+  factsValue: unknown,
+  inputValue: unknown,
+  verifierValue: unknown,
+): ProjectControlProofResult {
+  const context = parseHost(ProjectControlContextSchema, contextValue);
+  const facts = parseHost(ProjectControlFactsSchema, factsValue);
+  const parsedInput = ProjectControlProofInputSchema.safeParse(inputValue);
+  if (!parsedInput.success) throw new ProjectControlContractError('INVALID_INPUT');
+  const verifier = parseHost(ProjectControlSignatureVerifierSchema, verifierValue);
+  const result = (reason: ProjectControlReason): ProjectControlProofResult =>
+    Object.freeze({
+      version: 'v1',
+      challengeId: context.challengeId,
+      state: reason === 'SIGNATURE_BOUND' ? 'SIGNATURE_BOUND' : 'REJECTED',
+      reason,
+      informational: true,
+      isAuthorizationToken: false,
+      persisted: false,
+      founderControlVerified: false,
+      recognizesGuild: false,
+      activatesToken: false,
+      createsPermissionGrant: false,
+      consumesNonce: false,
+    });
+  if (!facts.actor.accountId || !facts.actor.sessionAuthorized)
+    return result('AUTHENTICATION_REQUIRED');
+  if (facts.actor.restricted) return result('ACCOUNT_RESTRICTED');
+  if (
+    facts.actor.accountId !== context.actorAccountId ||
+    facts.draft.ownerAccountId !== context.actorAccountId ||
+    facts.draft.id !== context.guildDraftId
+  )
+    return result('RESOURCE_UNAVAILABLE');
+  if (facts.draft.revision !== context.draftRevision) return result('REVISION_CHANGED');
+  if (facts.origin !== context.origin) return result('ORIGIN_MISMATCH');
+  if (facts.challengeState !== 'AVAILABLE') return result('CHALLENGE_UNAVAILABLE');
+  const now = Date.parse(facts.now);
+  if (now < Date.parse(context.issuedAt)) return result('CHALLENGE_NOT_YET_VALID');
+  if (now >= Date.parse(context.expiresAt)) return result('CHALLENGE_EXPIRED');
+  if (facts.policy.status !== 'APPROVED' || !sameReference(context.policy, facts.policy.reference))
+    return result('POLICY_UNAVAILABLE');
+  const current = (o: { observedAt: string; validUntil: string }) =>
+    now >= Date.parse(o.observedAt) && now < Date.parse(o.validUntil);
+  if (
+    facts.authority.status !== 'CURRENT' ||
+    !sameReference(context.authority, facts.authority.reference) ||
+    !sameReference(context.policy, facts.authority.policyReference) ||
+    !current(facts.authority) ||
+    facts.authority.signer !== context.signer ||
+    assetKey(facts.authority.assetId) !== assetKey(context.assetId)
+  )
+    return result('AUTHORITY_UNAVAILABLE');
+  if (
+    facts.publicEvidence.status !== 'VERIFIED' ||
+    !sameReference(context.publicEvidence, facts.publicEvidence.reference) ||
+    !sameReference(context.policy, facts.publicEvidence.policyReference) ||
+    !sameReference(context.authority, facts.publicEvidence.authorityReference) ||
+    !current(facts.publicEvidence) ||
+    assetKey(facts.publicEvidence.assetId) !== assetKey(context.assetId)
+  )
+    return result('PUBLIC_EVIDENCE_UNAVAILABLE');
+  let verified: unknown;
+  try {
+    verified = verifier.verify(
+      Object.freeze({
+        message: encode(context),
+        signature: parsedInput.data.signature,
+        signer: context.signer,
+      }),
+    );
+  } catch {
+    throw new ProjectControlContractError('VERIFIER_UNAVAILABLE');
+  }
+  if (typeof verified !== 'boolean') throw new ProjectControlContractError('INVALID_HOST_CONTRACT');
+  return result(verified ? 'SIGNATURE_BOUND' : 'SIGNATURE_INVALID');
+}
