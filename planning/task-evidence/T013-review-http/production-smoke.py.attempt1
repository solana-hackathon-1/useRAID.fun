import os,signal,socket,subprocess,time,json,urllib.request,urllib.error
from pathlib import Path
root=Path(Path('/tmp/raid-t013-review-http-build-path').read_text())
evidence=Path(__file__).resolve().parent
class Interrupted(BaseException):
 def __init__(self, sig): self.code=128+sig
def interrupt(sig, frame):raise Interrupted(sig)
for sig in [signal.SIGINT,signal.SIGTERM]:signal.signal(sig,interrupt)
with socket.socket() as sock:
 sock.bind(('127.0.0.1',0));port=sock.getsockname()[1]
env=dict(os.environ,NEXT_TELEMETRY_DISABLED='1',DEMO_MODE='true',DATABASE_URL='postgresql://postgres:synthetic-only@127.0.0.1:1/useraid_build_only')
log=(evidence/'production-server.log').open('w')
process=None;code=1;checks=[]
try:
 process=subprocess.Popen(['node_modules/.bin/next','start','--hostname','127.0.0.1','--port',str(port)],cwd=root,env=env,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
 path='/api/v1/practice/reviews/11111111-1111-4111-8111-111111111111/submissions/22222222-2222-4222-8222-222222222222?purpose=OWNERSHIP_REVIEW'
 url='http://127.0.0.1:'+str(port)+path
 for attempt in range(200):
  try:
   try:response=urllib.request.urlopen(url,timeout=1)
   except urllib.error.HTTPError as error:response=error
   break
  except urllib.error.URLError:
   if process.poll() is not None:raise RuntimeError('Owned production server exited')
   time.sleep(.1)
 else:raise RuntimeError('Owned production server not reachable')
 for method in ['GET','HEAD']:
  try:response=urllib.request.urlopen(urllib.request.Request(url,method=method),timeout=10)
  except urllib.error.HTTPError as error:response=error
  with response:
   body=response.read()
   assert response.status==401,(method,response.status)
   assert response.headers.get('Cache-Control')=='private, no-store'
   assert 'Cookie' in response.headers.get('Vary','')
   if method=='GET':assert json.loads(body)['error']['code']=='AUTHENTICATION_REQUIRED'
   else:assert body==b''
   checks.append({'method':method,'status':response.status,'privateNoStore':True,'varyCookie':True,'noPrivateBody':True})
 code=0
except Interrupted as error:code=error.code
finally:
 for sig in [signal.SIGINT,signal.SIGTERM]:signal.signal(sig,signal.SIG_IGN)
 if process and process.poll() is None:
  os.killpg(process.pid,signal.SIGTERM)
  try:process.wait(timeout=8)
  except subprocess.TimeoutExpired:
   os.killpg(process.pid,signal.SIGKILL);process.wait(timeout=5)
 log.close()
 with socket.socket() as sock:closed=sock.connect_ex(('127.0.0.1',port))!=0
 if not closed:code=1
 report={'mode':'production next start','source':str(root),'pid':process.pid if process else None,'loopbackPort':port,'checks':checks,'ownedServerStopped':closed,'result':code}
 (evidence/'production-smoke.json').write_text(json.dumps(report,indent=2)+'\n')
 print(json.dumps(report),flush=True)
raise SystemExit(code)
