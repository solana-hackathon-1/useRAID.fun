++    code =
++      error.code === 'IDEMPOTENCY_KEY_REUSED'
++        ? 'IDEMPOTENCY_KEY_REUSED'
++        : error.code === 'INVALID_INPUT'
++          ? 'INVALID_COMMAND'
++          : 'SERVICE_UNAVAILABLE';
++  }
++  const result = createErrorEnvelope(code, requestId);
++  return Response.json(result.body, { status: status ?? result.status, headers });
++}
