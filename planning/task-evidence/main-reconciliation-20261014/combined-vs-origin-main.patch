++    checkOrigin(request);
++    const authority = await actor();
++    await rateLimit(`orientation:${authority.accountId}`, 30, 60);
++    const key = InternalId.safeParse(request.headers.get('idempotency-key'));
++    if (!key.success) throw new BodyFailure(422);
