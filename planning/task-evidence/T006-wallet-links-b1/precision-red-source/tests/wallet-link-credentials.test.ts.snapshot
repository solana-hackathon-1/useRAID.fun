import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
import { Prisma, PrismaClient } from '@prisma/client';
import {
  IdentityLinkError,
  linkVerifiedWallet,
  resolveWalletCredential,
  revokeWalletCredential,
  type IdentityTransaction,
} from '../src/identity-link';
import { createPrismaIdentityTransaction } from '../src/lib/identity-storage-adapter';
import { assertTestDatabase, truncateAll } from './helpers/db-guard';
import { fixtureAddress, fixtureLinkInput, fixtureSession, FIXTURE_NOW } from './helpers/wallet-link-fixtures';
import { SIWS_CHAIN_ID, LINK_ADDITIONAL_STATEMENT, WALLET_CHALLENGE_STATEMENTS } from '../src/lib/wallet-challenge-contract';
import { SIWS_CHAIN_ID as proofChain, LINK_ADDITIONAL_STATEMENT as proofStatement } from '../src/lib/wallet-link-proof';
import { createWalletChallenge } from '../src/lib/wallet-auth';

const A = 'credentials-alice';
const B = 'credentials-bob';
const P = 'd4bbeef1-55a8-4d8e-8d03-f3b012f92401';
const ID = 'a1b2c3d4-0000-4000-8000-000000000001';
const PRIMARY = fixtureAddress(41);
const EXTRA = fixtureAddress(42);
const input = (address = EXTRA) => ({ subject: { address, networkIdentity: 'mainnet' }, walletNetworks: ['mainnet'] });
const revokeInput = (address = EXTRA, overrides = {}) => ({ ...input(address), accountId: A, actorAccountId: A, requestId: 'revoke-1', session: fixtureSession(A), now: FIXTURE_NOW, ...overrides });
const failureCode = async (work: Promise<unknown>) => work.then(() => 'NO_ERROR', (error: unknown) => error instanceof IdentityLinkError ? error.code : `OTHER:${String(error)}`);

function fake(world: { source?: 'PRIMARY'|'LINK'|'ABSENT'; status?: string; accountId?: string; participant?: string|null; suspended?: boolean; malformed?: boolean } = {}) {
  const calls: { sql: string; bindings: readonly string[] }[] = [];
  let status = world.status ?? 'ACTIVE';
  const owner = () => world.source === 'ABSENT' ? [] : [{ source: world.source ?? 'LINK', accountId: world.accountId ?? A, id: world.source === 'PRIMARY' ? null : ID, participantId: world.source === 'PRIMARY' ? null : P, status: world.source === 'PRIMARY' ? null : status, networkIdentity: world.source === 'PRIMARY' ? null : 'mainnet', revokedAt: status === 'REVOKED' ? FIXTURE_NOW : null }];
  const tx: IdentityTransaction = {
    dialect: 'POSTGRESQL', isolation: 'READ_COMMITTED',
    async query<Row>(sql: string, bindings: readonly string[]) {
      calls.push({ sql, bindings });
      let result: unknown[];
      if (sql.includes('pg_advisory_xact_lock')) result = [{ locked: 1 }];
      else if (sql.includes('FOR NO KEY UPDATE')) result = [{ id: bindings[0], suspended: world.suspended ?? false }];
      else if (sql.includes('UNION ALL')) result = world.malformed ? [...owner(), ...owner()] : owner();
      else if (sql.includes('FROM "Participant"')) result = world.participant === null ? [] : [{ id: world.participant ?? P, kind: 'HUMAN', accountId: A }];
      else if (sql.includes('UPDATE "WalletLink"')) { status = 'REVOKED'; result = [{ id: ID, revokedAt: FIXTURE_NOW }]; }
      else throw Error(`Unexpected SQL: ${sql}`);
      return result as Row[];
    },
  };
  return { tx, calls };
}

describe('B1 credential contracts using alternate injected ports', () => {
  it('publishes one vocabulary with unchanged legacy purpose bytes and compatible proof constants', () => {
    expect(SIWS_CHAIN_ID).toBe(proofChain);
    expect(LINK_ADDITIONAL_STATEMENT).toBe(proofStatement);
    expect(WALLET_CHALLENGE_STATEMENTS).toEqual({signin:'Sign in to useRAID.fun.',link:'Link this wallet to your useRAID.fun account.',rotate:'Change the wallet on your useRAID.fun account. Withdrawals pause for 24 hours.'});
  });
  it('resolves only internal account/participant context under subject then account locks, without writes', async () => {
    const {tx,calls} = fake();
    expect(await resolveWalletCredential(tx,input())).toEqual({ source:'LINK',accountId:A,participantId:P,linkId:ID,networkIdentity:'mainnet',address:EXTRA });
    expect(calls[0].sql).toContain('pg_advisory_xact_lock');
    expect(calls[0].bindings).toEqual([`wallet-subject:${EXTRA}`]);
    expect(calls.find(c => c.sql.includes('FOR NO KEY UPDATE'))?.bindings).toEqual([A]);
    expect(calls.some(c => /INSERT|UPDATE "WalletLink"|DELETE/.test(c.sql))).toBe(false);
  });
  it('leaves legitimate unmapped primary accounts unmapped; absent subject has no account lock', async () => {
    const primary = fake({ source:'PRIMARY',participant:null });
    expect(await resolveWalletCredential(primary.tx,input(PRIMARY))).toMatchObject({ source:'PRIMARY', accountId:A,participantId:null,linkId:null });
    expect(primary.calls.some(c => c.sql.includes('INSERT'))).toBe(false);
    const absent = fake({source:'ABSENT'});
    expect(await resolveWalletCredential(absent.tx,input())).toEqual({ source:'ABSENT' });
    expect(absent.calls.some(c => c.sql.includes('FROM "User"'))).toBe(false);
  });
  it.each([
    [{status:'REVOKED'}, 'IDENTITY_REVOKED'],
    [{suspended:true},'ACCOUNT_RESTRICTED'],
    [{participant:null},'STORAGE_CONTRACT'],
    [{participant:'d4bbeef1-55a8-4d8e-8d03-f3b012f92402'},'STORAGE_CONTRACT'],
    [{status:'INVALID'},'STORAGE_CONTRACT'],
    [{malformed:true},'STORAGE_CONTRACT'],
  ])('resolver rejects invalid durable ownership %j', async (world,code) => {
    expect(await failureCode(resolveWalletCredential(fake(world).tx,input()))).toBe(code);
  });
  it('revokes once, preserves permanent reservation, and repeats without another UPDATE', async () => {
    const {tx,calls} = fake();
    const first = await revokeWalletCredential(tx,revokeInput());
    expect(first).toEqual({outcome:'REVOKED',linkId:ID,participantId:P,address:EXTRA,networkIdentity:'mainnet',status:'REVOKED',revokedAt:FIXTURE_NOW});
    expect(await revokeWalletCredential(tx,revokeInput(EXTRA,{now:'2026-10-10T09:00:00.000Z'}))).toEqual({...first,outcome:'ALREADY_REVOKED'});
    expect(calls.filter(c => c.sql.includes('UPDATE "WalletLink"'))).toHaveLength(1);
    expect(calls.some(c => /DELETE|INSERT/.test(c.sql))).toBe(false);
  });
  it.each([
    [{actorAccountId:B},'WRONG_ACTOR'],
    [{session:fixtureSession(B)},'FORBIDDEN'],
    [{session:fixtureSession(A,{state:'REVOKED'})},'AUTHENTICATION_REQUIRED'],
    [{session:fixtureSession(A,{expiresAt:FIXTURE_NOW})},'AUTHENTICATION_REQUIRED'],
    [{now:'2026-10-09T09:00:00.100Z',session:fixtureSession(A,{expiresAt:'2026-10-09T09:00:00Z'})},'AUTHENTICATION_REQUIRED'],
    [{requestId:''},'INVALID_INPUT'],
  ])('rejects untrusted caller input before SQL %j', async (overrides,code) => {
    const {tx,calls}=fake();
    expect(await failureCode(revokeWalletCredential(tx,revokeInput(EXTRA,overrides)))).toBe(code);
    expect(calls).toHaveLength(0);
  });
  it('protects own primary and returns identical sanitized failure for missing or foreign targets', async () => {
    expect(await failureCode(revokeWalletCredential(fake({source:'PRIMARY'}).tx,revokeInput(PRIMARY)))).toBe('PRIMARY_WALLET_PROTECTED');
    const codes = await Promise.all([fake({source:'ABSENT'}),fake({accountId:B})].map(({tx}) => failureCode(revokeWalletCredential(tx,revokeInput()))));
    expect(codes).toEqual(['IDENTITY_CONFLICT','IDENTITY_CONFLICT']);
  });
  it.each([resolveWalletCredential,revokeWalletCredential])('both commands fail closed on wrong isolation, network and opaque storage failure', async command => {
    const tx=fake().tx;
    expect(await failureCode(command({...tx,isolation:'SERIALIZABLE'} as unknown as IdentityTransaction,revokeInput()))).toBe('STORAGE_CONTRACT');
    expect(await failureCode(command(tx,{...revokeInput(),walletNetworks:['devnet']}))).toBe('UNSUPPORTED_IDENTITY');
    const bad = {...tx,query:async () => { throw Error(`secret ${EXTRA} ${A}`); }};
    const error=await command(bad,revokeInput()).catch(e=>e);
    expect(error).toBeInstanceOf(IdentityLinkError);
    expect(error.message).toBe('STORAGE_UNAVAILABLE');
    expect(JSON.stringify(error)).not.toContain(EXTRA);
  });
});

const integration=process.env.RUN_DB_TESTS === 'true' ? describe : describe.skip;
integration('B1 credentials on real PostgreSQL', () => {
  const db=new PrismaClient({log:[]});
  const options={isolationLevel:Prisma.TransactionIsolationLevel.ReadCommitted,timeout:20000};
  const run=<T>(work:(tx:IdentityTransaction)=>Promise<T>)=>db.$transaction(tx=>work(createPrismaIdentityTransaction(tx)),options);
  beforeAll(()=>assertTestDatabase());
  beforeEach(async()=>{
    await truncateAll(db);
    await db.user.create({data:{id:A,handle:A}});
    await db.user.create({data:{id:B,handle:B}});
    await db.walletIdentity.create({data:{address:PRIMARY,userId:A}});
  });
  afterAll(async()=>{await truncateAll(db);await db.$disconnect();});
  const snapshot=async()=>({users:await db.user.findMany({orderBy:{id:'asc'}}),participants:await db.participant.findMany(),primary:await db.walletIdentity.findMany(),links:await db.walletLink.findMany()});
  it('resolves unmapped legacy primary without provisioning and links preserve canonical context', async()=>{
    const before=await snapshot();
    expect(await run(tx=>resolveWalletCredential(tx,input(PRIMARY)))).toMatchObject({source:'PRIMARY',accountId:A,participantId:null});
    expect(await snapshot()).toEqual(before);
    const linked=await run(tx=>linkVerifiedWallet(tx,fixtureLinkInput(A,EXTRA)));
    const after=await snapshot();
    expect(await run(tx=>resolveWalletCredential(tx,input()))).toMatchObject({source:'LINK',accountId:A,participantId:linked.participantId,linkId:linked.linkId});
    expect(await snapshot()).toEqual(after);
  });
  it('existing generator uses the shared legacy vocabulary without issuing additional-link purposes', async()=>{
    for (const purpose of ['signin','link','rotate'] as const) {
      const challenge=await createWalletChallenge(EXTRA,purpose==='signin'?undefined:A,purpose);
      expect(challenge.message.split('\n')[3]).toBe(WALLET_CHALLENGE_STATEMENTS[purpose]);
      expect(challenge.message.split('\n')[7]).toBe(`Chain ID: ${SIWS_CHAIN_ID}`);
    }
  });
  it('revoke keeps immutable provenance, rejects primary/foreign targets and leaves address reserved', async()=>{
    await run(tx=>linkVerifiedWallet(tx,fixtureLinkInput(A,EXTRA)));
    const before=await snapshot();
    const result=await run(tx=>revokeWalletCredential(tx,revokeInput()));
    expect(result.status).toBe('REVOKED');
    const after=await snapshot();
    expect(after.links[0]).toEqual({...before.links[0],status:'REVOKED',revokedAt:new Date(FIXTURE_NOW)});
    expect(after.users).toEqual(before.users);expect(after.primary).toEqual(before.primary);expect(after.participants).toEqual(before.participants);
    expect(await run(tx=>revokeWalletCredential(tx,revokeInput()))).toEqual({...result,outcome:'ALREADY_REVOKED'});
    expect(await failureCode(run(tx=>resolveWalletCredential(tx,input())))).toBe('IDENTITY_REVOKED');
    expect(await failureCode(run(tx=>revokeWalletCredential(tx,revokeInput(PRIMARY))))).toBe('PRIMARY_WALLET_PROTECTED');
    expect(await failureCode(run(tx=>revokeWalletCredential(tx,revokeInput(EXTRA,{accountId:B,actorAccountId:B,session:fixtureSession(B)}))))).toBe('IDENTITY_CONFLICT');
    await expect(db.walletIdentity.create({data:{address:EXTRA,userId:B}})).rejects.toMatchObject({code:'P2002'});
    expect(await snapshot()).toEqual(after);
  });
  it('restricted owner cannot resolve or revoke and malformed trusted session causes no mutation', async()=>{
    await run(tx=>linkVerifiedWallet(tx,fixtureLinkInput(A,EXTRA)));
    await db.user.update({where:{id:A},data:{suspended:true}});
    const before=await snapshot();
    expect(await failureCode(run(tx=>resolveWalletCredential(tx,input())))).toBe('ACCOUNT_RESTRICTED');
    expect(await failureCode(run(tx=>revokeWalletCredential(tx,revokeInput())))).toBe('ACCOUNT_RESTRICTED');
    expect(await snapshot()).toEqual(before);
  });

  const deferred=()=>{let resolve!:()=>void;const promise=new Promise<void>(done=>{resolve=done;});return{promise,resolve};};
  const pid=async(tx:Prisma.TransactionClient)=>(await tx.$queryRawUnsafe<{pid:number}[]>('SELECT pg_backend_pid() AS pid'))[0].pid;
  async function observedBlock(waiter:number,blocker:number,statement:RegExp) {
    expect(waiter).not.toBe(blocker);
    const deadline=Date.now()+5000;
    while(Date.now()<deadline) {
      const rows=await db.$queryRawUnsafe<{query:string;blockers:number[]}[]>('SELECT query,pg_blocking_pids(pid) AS blockers FROM pg_stat_activity WHERE pid=$1',waiter);
      if(rows[0]?.blockers.includes(blocker)) {expect(rows[0].query).toMatch(statement);console.info(JSON.stringify({credentialRace:true,waiter,blocker,blockedStatement:rows[0].query.slice(0,150)}));return;}
      await new Promise(done=>setTimeout(done,10));
    }
    throw Error('No real PostgreSQL blocking relationship observed');
  }
  it.each(['resolve-first','revoke-first','account-lock'] as const)('resolver and revoke serialize with actual held %s locks',async(order)=>{
    await run(tx=>linkVerifiedWallet(tx,fixtureLinkInput(A,EXTRA)));
    const ready=deferred(),release=deferred(),started=deferred();
    let blocker=0,waiter=0;
    const held=db.$transaction(async(tx)=>{
      blocker=await pid(tx);
      const port=createPrismaIdentityTransaction(tx);
      const result=order==='revoke-first'?await revokeWalletCredential(port,revokeInput()):await resolveWalletCredential(port,input(order==='account-lock'?PRIMARY:EXTRA));
      ready.resolve();await release.promise;return result;
    },options);
    held.catch(()=>ready.resolve());
    await ready.promise;
    const waiting=db.$transaction(async(tx)=>{
      waiter=await pid(tx);started.resolve();
      const port=createPrismaIdentityTransaction(tx);
      return order==='revoke-first'?resolveWalletCredential(port,input()):revokeWalletCredential(port,revokeInput());
    },options).then(result=>({result,code:'NO_ERROR'}),error=>({result:null,code:error instanceof IdentityLinkError?error.code:String(error)}));
    await started.promise;
    try {await observedBlock(waiter,blocker,order==='account-lock'?/FROM "User".*FOR NO KEY UPDATE/s:/pg_advisory_xact_lock/);}
    finally {release.resolve();}
    await held;
    const losing=await waiting;
    expect(losing.code).toBe(order==='revoke-first'?'IDENTITY_REVOKED':'NO_ERROR');
    expect((await db.walletLink.findUniqueOrThrow({where:{address:EXTRA}})).status).toBe('REVOKED');
  },15000);
});
