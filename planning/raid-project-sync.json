    "Epic": {
      "__typename": "ProjectV2SingleSelectField",
      "id": "PVTSSF_lADOFC4ies4Bl6XMzhklWnU",
      "name": "Epic",
      "options": [
        {
          "id": "928fc6cb",
          "name": "E01 — Shared contracts and engineering foundation",
          "color": "PURPLE",
          "description": "Give every developer one reliable set of IDs, types, state transitions and implementation evidence."
        },
        {
          "id": "40d73e6b",
          "name": "E02 — Canonical identity and secure onboarding",
          "color": "PURPLE",
          "description": "Keep one work identity and history when a person changes wallets or login methods."
        },
        {
          "id": "cb04bdf9",
          "name": "E03 — Guilds, founder authority and holder membership",
          "color": "PURPLE",
          "description": "Let verified projects manage work while keeping holder membership separate from ownership and permissions."
        },
        {
          "id": "f2735584",
          "name": "E04 — Skill evidence, assessment and fair admission",
          "color": "PURPLE",
          "description": "Help beginners find starter work and experienced builders demonstrate the relevant ability without buying a rank."
        },
        {
          "id": "99f07e1d",
          "name": "E05 — Raid creation, terms and recommendations",
          "color": "PURPLE",
          "description": "Give founders a clear task contract and useful bounded difficulty/reward guidance."
        },
        {
          "id": "c462d393",
          "name": "E06 — One active engagement and reliable commands",
          "color": "PURPLE",
          "description": "Make double acceptance impossible at the database boundary across every admission path."
        },
        {
          "id": "210560dc",
          "name": "E07 — Deliverables, review, closure and workspaces",
          "color": "PURPLE",
          "description": "Let contributors deliver versioned proof and get bounded review without losing unpaid claims."
        },
        {
          "id": "ce22dae4",
          "name": "E08 — Selected token launch and verified Guild linkage",
          "color": "PURPLE",
          "description": "Create and independently verify one supported launch instead of treating a returned signature as success."
        },
        {
          "id": "ff096c8b",
          "name": "E09 — Exact assets, funding, escrow and settlement",
          "color": "PURPLE",
          "description": "Protect the exact reward promised to every contributor and pay each immutable claim once."
        },
        {
          "id": "1fe8a8f3",
          "name": "E10 — Disputes, finality, appeals and beneficiary recovery",
          "color": "PURPLE",
          "description": "Resolve contested work through explicit authority and preserve claims while duties close."
        },
        {
          "id": "db3def86",
          "name": "E11 — Configuration, durability and supported operations",
          "color": "PURPLE",
          "description": "Make the web/worker system observable, recoverable and supportable without losing acknowledged obligations."
        },
        {
          "id": "e8930593",
          "name": "E12 — Internal alpha and core acceptance evidence",
          "color": "PURPLE",
          "description": "Prove the integrated core internally before inviting outside testers."
        },
        {
          "id": "cf9ef70e",
          "name": "E13 — Closed beta and controlled V1 release",
          "color": "PURPLE",
          "description": "Validate real founder/Raider behavior in a small supported cohort before public beta."
        },
        {
          "id": "ee9e8ec3",
          "name": "E14 — Public discovery, notifications, metrics and beta",
          "color": "PURPLE",
          "description": "Help people discover appropriate work and see truthful progress without leaking private material."
        },
        {
          "id": "1dc4ddd1",
          "name": "E15 — Private briefs, repositories and explicit access",
          "color": "PURPLE",
          "description": "Give only approved people scoped resources and verify effective removal without deleting unrelated rights."
        },
        {
          "id": "71194208",
          "name": "E16 — Parties, consent and exact team rewards",
          "color": "PURPLE",
          "description": "Let a real consenting team deliver one assignment with individually protected capacity and payouts."
        },
        {
          "id": "b1d1f9bc",
          "name": "E17 — Selection Challenges and prize competitions",
          "color": "PURPLE",
          "description": "Pay promised selection work, choose a builder fairly, and offer main work through a separate funded agreement."
        },
        {
          "id": "df11978b",
          "name": "E18 — Sponsored placement and funded auctions",
          "color": "PURPLE",
          "description": "Sell visibly labeled inventory and reconcile delivery, charge and refund without buying credibility."
        },
        {
          "id": "4e81b3e8",
          "name": "E19 — Accountable managed AI workers",
          "color": "PURPLE",
          "description": "Run evaluated AI work under real identity, permission, capacity and total-spend limits."
        },
        {
          "id": "66efc904",
          "name": "E20 — Approved influencer channels and attribution",
          "color": "PURPLE",
          "description": "Separate content creation from approved publication and verify honest delivered evidence."
        },
        {
          "id": "bd8c8849",
          "name": "E21 — Versioned reputation and advanced Guild economy",
          "color": "PURPLE",
          "description": "Build attributable fair reputation and consented funded Roles; keep unapproved token policy disabled."
        },
        {
          "id": "bea6840f",
          "name": "E22 — User acceptance testing and business sign-off",
          "color": "PURPLE",
          "description": "Confirm that real users understand and can complete the promised workflow, separately from developers proving technical correctness."
        },
        {
          "id": "0dc1a37f",
          "name": "E23 — Master RAID blueprint and complete delivery coverage",
          "color": "PURPLE",
          "description": "Keep the entire canonical RAID blueprint visible on the board, with every domain/subsection traced to concrete developer work and the evidence needed for delivery."
        }
      ]
    },
